only_side_refs=1
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/notes/* | refs/check/*) ;;
    *) only_side_refs=0 ;;
  esac
done
if [ "$only_side_refs" = 1 ]; then
  exit 0
fi
unset $(git rev-parse --local-env-vars)
if ! command -v check >/dev/null 2>&1; then
  echo "pre-push: check is not on PATH, so this push cannot be judged and is refused" >&2
  exit 1
fi
check --full --publish
