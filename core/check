#!/bin/bash
set -uo pipefail

core="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
repo="$(cd "$core/.." && pwd)"
PATH="$repo/node_modules/.bin:$PATH"
cd "$repo" || exit 1

limit=200
log="$(git rev-parse --path-format=absolute --git-common-dir)/core-logs/check-$(git rev-parse --short HEAD)-${repo##*/}.log"
mkdir -p "${log%/*}"
rm -f "$log"
[[ $log == "$repo/"* ]] && shown="${log#"$repo/"}" || shown="$log"

names=""
located=""
run() {
  local name=$1 output at
  shift
  if ! output=$("$@" 2>&1); then
    printf -- '--- %s ---\n%s\n' "$name" "$output" >>"$log"
    at=$(grep -oE '[A-Za-z0-9_./-]+\.(ts|js|json)(:[0-9]+|\([0-9]+)?' <<<"$output" | grep -m1 -E '[:(][0-9]+$' ||
      grep -m1 -oE '[A-Za-z0-9_./-]+\.(ts|js|json)' <<<"$output")
    at="${at#"$repo/"}"
    at="${at/(/:}"
    names="$names $name"
    located="$located${located:+,} $name${at:+ $at}"
  fi
}

run typecheck tsc --noEmit --pretty false -p core/tsconfig.json
run lint eslint --config core/eslint.config.js core
run unused knip --config core/knip.config.ts --no-config-hints
run clones jscpd core --threshold 0 --min-tokens 50 --min-lines 5 --format typescript,javascript --silent
run test vitest run --config core/vitest.config.ts
run links node core/part-links.ts

if [ -z "$names" ]; then
  printf 'core/check: passed\n'
  exit 0
fi
message="core/check: FAILED$located; log $shown"
((${#message} > limit)) && message="core/check: FAILED$names; log $shown"
printf '%s\n' "$message"
exit 1
