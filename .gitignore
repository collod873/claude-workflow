# Claude Code local state
.claude/settings.local.json
.claude/state/
.claude/logs/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Scratch
tmp/
scratch/
*.log

# The clone gate's scan copies (bin/clone-gate). Deleted after every run; ignored so a killed
# run's leftovers are never committed.
.clone-gate-scan/

# The rule trial's detached worktree (.Workflow/agent-workflows/ratify/rule-trial.ts). Staged
# inside the repo so eslint resolves its plugins out of node_modules; torn down after every trial,
# ignored so a killed run's leftovers are never committed into the batch it was deciding.
.ratify-trial/

# Node
node_modules/
dist/
build/

# Pipeline runtime handoff (regenerated per run, never source)
.Workflow/agent-workflows/handoff.txt

# Pipeline stage checkpoints (regenerated per run, never source)
.Workflow/agent-workflows/checkpoints/

# A local debug run's refused response, written beside the handoff by
# preservingRaw. Evidence for whoever is reading it now, not a repo file.
.Workflow/agent-workflows/*-raw-response.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
# Agent worktrees are machine-local sessions, never part of the tree they branch from.
.claude/worktrees/
