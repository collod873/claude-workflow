# Claude Code local state
.claude/settings.local.json
.claude/state/
.claude/logs/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Scratch
tmp/
scratch/
*.log

# Node
node_modules/
# tsc's incremental state (tsconfig.json#incremental); regenerated by every typecheck.
.tsbuildinfo
dist/
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
# Agent worktrees are machine-local sessions, never part of the tree they branch from.
.claude/worktrees

# ~/bin/md-html's rendered page for the doc beside it, rebuilt from that .md on every edit
# (the md-html-refresh hook). A build of a tracked file, never the source of one.
docs/**/*.html
