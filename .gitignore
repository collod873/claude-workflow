# Claude Code local state
.claude/settings.local.json
.claude/state/
.claude/logs/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Scratch
tmp/
scratch/
*.log

# The clone gate's scan copies (bin/clone-gate). Deleted after every run; ignored so a killed
# run's leftovers are never committed.
.clone-gate-scan/

# Node
node_modules/
dist/
build/

# Pipeline runtime handoff (regenerated per run, never source)
.Workflow/agent-workflows/handoff.txt

# A local debug run's refused response, written beside the handoff by
# preservingRaw. Evidence for whoever is reading it now, not a repo file.
.Workflow/agent-workflows/*-raw-response.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
