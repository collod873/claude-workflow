#!/usr/bin/env python3
import hashlib
import json
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
STAMP = "STAMP.json"
CACHES = {"node_modules", "__pycache__", ".ruff_cache", ".eslintcache"}


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def drift(stamp: dict) -> list[str]:
    present = {str(path.relative_to(HERE)) for path in HERE.rglob("*") if path.is_file() and path.name != STAMP
               and not CACHES & set(path.parts)}
    found = [f"lint/{name} is missing" for name in sorted(set(stamp["files"]) - present)]
    found += [f"lint/{name} is not part of {stamp['source']}" for name in sorted(present - set(stamp["files"]))]
    found += [f"lint/{name} was edited here" for name in sorted(present & set(stamp["files"]))
              if digest(HERE / name) != stamp["files"][name]]
    return found


def main() -> int:
    stamp = json.loads((HERE / STAMP).read_text())
    found = drift(stamp)
    if found:
        print("\n".join(f"✗ {line}" for line in found))
        print(f"✗ lint/ is synced from {stamp['source']} and takes no local edits; fix it there, or run lint-sync install")
        return 1
    return subprocess.run([str(HERE / stamp["layer"] / "run")], check=False).returncode


if __name__ == "__main__":
    sys.exit(main())
