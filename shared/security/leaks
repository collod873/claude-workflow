#!/usr/bin/env python3
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tools import PINS, ToolUnavailable, tool

SYNC_MANIFESTS = ("kit/KIT.json", "shared/STAMP.json")
OWN_CONFIG = ".gitleaks.toml"
IGNORES = ".gitleaksignore"
SUBMODULE = "160000"


def config(tree: Path, scratch: Path) -> Path:
    own = tree / OWN_CONFIG
    base = f'path = "{own}"' if own.is_file() else "useDefault = true"
    manifests = ", ".join(f"'^{re.escape(name)}$'" for name in SYNC_MANIFESTS)
    written = scratch / "gitleaks.toml"
    written.write_text(f"[extend]\n{base}\n\n[[allowlists]]\npaths = [{manifests}]\n")
    return written


def staged(root: Path) -> dict[str, str]:
    listed = subprocess.run(["git", "ls-files", "--stage", "-z"], cwd=root, capture_output=True, text=True,
                            check=True).stdout
    blobs = {}
    for row in listed.split("\0"):
        if not row:
            continue
        meta, path = row.split("\t", 1)
        mode, blob, stage = meta.split()
        if stage == "0" and mode != SUBMODULE:
            blobs[path] = blob
    return blobs


def digests(blobs: dict[str, str]) -> dict[str, str]:
    judged_by = [PINS["gitleaks"].version, hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
                 blobs.get(OWN_CONFIG, ""), blobs.get(IGNORES, "")]
    return {path: hashlib.sha256(json.dumps([*judged_by, path, blob]).encode()).hexdigest()
            for path, blob in blobs.items()}


class ScanFailed(Exception):
    pass


def scanned(root: Path, paths: list[str]) -> list[dict]:
    try:
        gitleaks = tool("gitleaks")
    except ToolUnavailable as unavailable:
        raise ScanFailed(str(unavailable)) from unavailable
    with tempfile.TemporaryDirectory(prefix="shared-leaks-") as scratch:
        tree = Path(scratch) / "tree"
        report = Path(scratch) / "report.json"
        subprocess.run(["git", "checkout-index", "--stdin", "-z", f"--prefix={tree}/"], cwd=root, check=True,
                       input="".join(f"{path}\0" for path in paths).encode())
        ran = subprocess.run([str(gitleaks), "dir", ".", "--no-banner", "--redact", "--exit-code", "1",
                              "--report-format", "json", "--report-path", str(report),
                              "--config", str(config(tree, Path(scratch)))],
                             cwd=tree, capture_output=True, text=True, check=False)
        if ran.returncode not in (0, 1):
            raise ScanFailed(f"gitleaks failed: {ran.stderr.strip()[-400:]}")
        return json.loads(report.read_text() or "[]") if report.is_file() else []


def main() -> int:
    root = Path.cwd()
    handed = Path(os.environ["CHECK_FILE_RECEIPTS"]) if os.environ.get("CHECK_FILE_RECEIPTS") else None
    held = set((handed / "held").read_text().split()) if handed else set()
    blobs = staged(root)
    keyed = digests(blobs)
    due = sorted(path for path, digest in keyed.items() if digest not in held)
    if handed:
        with (handed / "linted").open("a") as tally:
            tally.write(json.dumps({"stage": "gitleaks", "ran": len(due), "covered": len(keyed) - len(due)}) + "\n")
    try:
        leaks = scanned(root, sorted({*due, *(name for name in (OWN_CONFIG, IGNORES) if name in blobs)})) if due else []
    except ScanFailed as failed:
        print(f"✗ leaks: {failed}")
        return 1
    for leak in leaks:
        print(f"✗ {leak['File']}:{leak['StartLine']}: {leak['RuleID']}")
    if leaks:
        print("✗ leaks: rotate each key, then remove it; a false alarm's fingerprint goes in .gitleaksignore")
        return 1
    if handed:
        with (handed / "passed").open("a") as passed:
            passed.write("".join(f"{keyed[path]}\n" for path in due))
    print("✓ leaks: no secret in the committed or staged tree")
    return 0


if __name__ == "__main__":
    sys.exit(main())
