#!/usr/bin/env python3
import json
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tools import ToolUnavailable, tool


def main() -> int:
    root = Path.cwd()
    try:
        gitleaks = tool("gitleaks")
    except ToolUnavailable as unavailable:
        print(f"✗ secrets: {unavailable}")
        return 1
    with tempfile.TemporaryDirectory(prefix="shared-secrets-") as scratch:
        tree = Path(scratch) / "tree"
        report = Path(scratch) / "report.json"
        subprocess.run(["git", "checkout-index", "--all", f"--prefix={tree}/"], cwd=root, check=True)
        scanned = subprocess.run([str(gitleaks), "dir", str(tree), "--no-banner", "--redact", "--exit-code", "1",
                                  "--report-format", "json", "--report-path", str(report)],
                                 cwd=tree, capture_output=True, text=True, check=False)
        if scanned.returncode not in (0, 1):
            print(f"✗ secrets: gitleaks failed: {scanned.stderr.strip()[-400:]}")
            return 1
        leaks = json.loads(report.read_text() or "[]") if report.is_file() else []
    for leak in leaks:
        print(f"✗ {Path(leak['File']).relative_to(tree)}:{leak['StartLine']}: {leak['RuleID']}")
    if leaks:
        print("✗ secrets: rotate each key, then remove it; a false alarm's fingerprint goes in .gitleaksignore")
        return 1
    print("✓ secrets: no secret in the committed or staged tree")
    return 0


if __name__ == "__main__":
    sys.exit(main())
