#!/usr/bin/env python3
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
STAMP = "STAMP.json"
CACHES = {"node_modules", "__pycache__", ".ruff_cache", ".eslintcache"}


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def drift(stamp: dict) -> list[str]:
    present = {str(path.relative_to(HERE)) for path in HERE.rglob("*") if path.is_file() and path.name != STAMP
               and not CACHES & set(path.parts)}
    found = [f"shared/{name} is missing" for name in sorted(set(stamp["files"]) - present)]
    found += [f"shared/{name} is not part of {stamp['source']}" for name in sorted(present - set(stamp["files"]))]
    found += [f"shared/{name} was edited here" for name in sorted(present & set(stamp["files"]))
              if digest(HERE / name) != stamp["files"][name]]
    return found


def verbs(layer: str) -> dict[str, Path]:
    return {path.name: path for folder in ("security", layer) if (HERE / folder).is_dir()
            for path in (HERE / folder).iterdir() if path.is_file() and os.access(path, os.X_OK)}


def main() -> int:
    stamp = json.loads((HERE / STAMP).read_text())
    found = drift(stamp)
    if found:
        print("\n".join(f"✗ {line}" for line in found))
        print(f"✗ shared/ is synced from {stamp['source']} and takes no local edits; fix it there, or run lint-sync install")
        return 1
    verb = sys.argv[1] if len(sys.argv) > 1 else "run"
    taken = verbs(stamp["layer"])
    if verb not in taken:
        named = " or ".join(sorted(name for name in taken if name != "run"))
        print(f"✗ shared/run for the {stamp['layer']} layer takes {named} or nothing, not {verb}")
        return 2
    return subprocess.run([str(taken[verb]), *sys.argv[2:]], check=False).returncode


if __name__ == "__main__":
    sys.exit(main())
