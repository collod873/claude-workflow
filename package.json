    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "knip": "^6.33.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
