{
  "name": "claude-workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky && if [ -d .husky/_ ]; then git config core.hooksPath \"$(git rev-parse --path-format=absolute --git-common-dir)/../.husky/_\"; fi",
    "test": "vitest run .claude bin",
    "clones": "jscpd",
    "adrs": "tsx bin/lib/adr-index.cli.ts .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && knip"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "knip": "^6.33.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "jscpd": {
    "threshold": 0,
    "format": [
      "typescript"
    ],
    "minTokens": 50,
    "minLines": 5,
    "gitignore": true,
    "ignore": [
      "**/node_modules/**",
      ".claude/worktrees/**",
      "core/**"
    ],
    "reporters": [
      "consoleFull"
    ],
    "absolute": true
  },
  "workspaces": [
    "lib/md-html"
  ]
}
