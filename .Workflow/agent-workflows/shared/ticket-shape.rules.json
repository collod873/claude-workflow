{
  "claimLimit": 8,
  "fragments": {
    "checkMarkerDelim": "(?:—|–|(?<=[ \\t])-{1,2}(?=[ \\t]))",
    "criteriaItem": "^[ \\t]*-[ \\t]*\\[[ xX]\\]"
  },
  "grammar": {
    "lineTerminator": { "source": "\\r\\n|[\\r\\v\\f\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]", "flags": "g" },
    "criteriaHeading": { "source": "^##[ \\t]+Acceptance criteria[ \\t\\r]*$", "flags": "m" },
    "criteriaItem": { "source": "{criteriaItem}", "flags": "m" },
    "criteriaItemStrip": { "source": "{criteriaItem}[ \\t]*", "flags": "" },
    "filesClaimedHeading": { "source": "^##[ \\t]+Files claimed[ \\t\\r]*$", "flags": "m" },
    "nextHeading": { "source": "^##[ \\t]", "flags": "m" },
    "noFilesSentinel": { "source": "^None(?![A-Za-z0-9_])[^\\n]*no files", "flags": "i" },
    "checkMarkerAttempt": { "source": "{checkMarkerDelim}[ \\t]*check:", "flags": "i" },
    "checkMarker": { "source": "{checkMarkerDelim}[ \\t]*check:[ \\t]*`([^`\\n]+)`[ \\t\\r]*$", "flags": "" }
  },
  "refusals": {
    "missingCriteriaHeading": "missing required '## Acceptance criteria' heading",
    "criteriaHeadingWithoutItems": "'## Acceptance criteria' heading has no '- [ ]' items; plain '- ' bullets don't count",
    "missingFilesClaimedHeading": "missing required '## Files claimed' heading",
    "claimTooWide": "'## Files claimed' names {count} files; {limit} is the ceiling. Lane 04's author inlines every claimed file into one prompt, so a claim this wide spends the whole lane budget on its first pass and dies at author-repair with nothing authored (#539). Split it into slices of one subject each."
  }
}
