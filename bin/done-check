#!/bin/bash
set -uo pipefail

usage="done-check: usage: done-check <issue number> [--tries <file to write the tries to, posting nothing>]"

if [[ ${1:-} == "--help" ]]; then
  printf '%s\n' "$usage"
  exit 0
fi

issue=${1:-}
if [[ ! $issue =~ ^[0-9]+$ ]] || ! [[ $# -eq 1 || ($# -eq 3 && $2 == --tries) ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
exec node "$src/done-checker.ts" "$@"
