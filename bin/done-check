#!/bin/bash
set -uo pipefail

usage="done-check: usage: done-check <issue number> [--asked]"

if [[ ${1:-} == "--help" ]]; then
  printf '%s\n' "$usage"
  exit 0
fi

issue=${1:-}
if [[ ! $issue =~ ^[0-9]+$ ]] || (($# > 2)) || { (($# == 2)) && [[ $2 != --asked ]]; }; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
exec node "$src/done-checker.ts" "$@"
