#!/bin/bash
set -uo pipefail

usage="done-check: usage: done-check <issue number> [--wave <sentence numbers>]"

if [[ ${1:-} == "--help" ]]; then
  printf '%s\n' "$usage"
  exit 0
fi

issue=${1:-}
numbers="${*:3}"
if [[ ! $issue =~ ^[0-9]+$ ]] || { (($# != 1)) && [[ ${2:-} != --wave || ! $numbers =~ ^[0-9]+([\ ,]+[0-9]+)*$ ]]; }; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
exec node "$src/done-checker.ts" "$issue" ${2:+"$2" "$numbers"}
