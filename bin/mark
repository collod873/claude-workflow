#!/bin/bash
set -uo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if ! spelled=$("$here/spelled" labels 2>&1); then
  printf 'mark: the labels could not be read: %s\n' "$(printf '%s' "$spelled" | head -n 1 | cut -c 1-120)" >&2
  exit 1
fi
if ! prefix=$("$here/spelled" TICKET_PREFIX 2>&1); then
  printf 'mark: the branch prefix could not be read: %s\n' "$(printf '%s' "$prefix" | head -n 1 | cut -c 1-120)" >&2
  exit 1
fi
states=()
parked=()
owners=()
try=""
declare -A colours descriptions
while IFS=$'\t' read -r name kind colour description; do
  case $kind in
    state) states+=("$name") ;;
    parked) parked+=("$name") ;;
    owner) owners+=("$name") ;;
    try) try=$name ;;
  esac
  colours[$name]=$colour
  descriptions[$name]=$description
done <<<"$spelled"
steps=("${states[@]}" "${parked[@]}")
usage="mark: usage: mark <number> <$(IFS='|'; printf '%s' "${steps[*]}")> [--try|--untry] | mark <number> <$(IFS='|'; printf '%s' "${owners[*]}")> | mark <number> --closed"

number=${1:-}
label=${2:-}
count=${3:-}
refused() {
  printf '%s\n' "$usage" >&2
  exit 2
}
[[ $number =~ ^[0-9]+$ ]] || refused
if [[ " ${states[*]} " == *" $label "* ]]; then
  (($# == 2)) || [[ $# -eq 3 && ($count == --try || $count == --untry) ]] || refused
elif [[ " ${parked[*]} ${owners[*]} --closed " == *" $label "* ]]; then
  (($# == 2)) || refused
else
  refused
fi

machine() { [[ " ${states[*]} ${parked[*]} ${owners[*]} " == *" $1 "* || $1 =~ ^$try[0-9]+$ ]]; }

spelling() { [[ $1 =~ ^$try[0-9]+$ ]] && printf '%s' "$try" || printf '%s' "$1"; }

said=""
failed() {
  printf 'mark: #%s not labelled %s: %s\n' "$1" "$label" "$(printf '%s' "$said" | head -n 1 | cut -c 1-120)" >&2
  exit 1
}

held=()
read_labels() {
  said=$(gh api "repos/{owner}/{repo}/issues/$1" --jq '.labels[].name' 2>&1) || failed "$1"
  mapfile -t held < <(printf '%s' "$said" | grep -v '^$')
}

apply() {
  local on=$1 name
  shift
  read_labels "$on"
  local adding=()
  for name in "$@"; do
    [[ " ${held[*]} " == *" $name "* ]] && continue
    gh label create "$name" --color "${colours[$(spelling "$name")]}" --description "${descriptions[$(spelling "$name")]}" >/dev/null 2>&1 # quiet: the label already exists, and a real refusal fails the labelling call below
    adding+=(-f "labels[]=$name")
  done
  if ((${#adding[@]})); then
    said=$(gh api -X POST "repos/{owner}/{repo}/issues/$on/labels" "${adding[@]}" 2>&1 >/dev/null) || failed "$on"
  fi
  for name in "${held[@]}"; do
    machine "$name" && [[ " $* " != *" $name "* ]] || continue
    said=$(gh api -X DELETE "repos/{owner}/{repo}/issues/$on/labels/$name" 2>&1 >/dev/null) || failed "$on"
  done
}

read_labels "$number"
target=()
if [[ $label == --closed ]]; then
  apply "$number"
  printf 'mark: #%s is closed, so it keeps only its kind\n' "$number"
  exit 0
elif [[ " ${owners[*]} " == *" $label "* ]]; then
  for name in "${held[@]}"; do
    machine "$name" && [[ $name != "$label" ]] && target+=("$name")
  done
  target+=("$label")
else
  tries=1
  for name in "${held[@]}"; do
    [[ $name =~ ^$try([0-9]+)$ ]] && ((BASH_REMATCH[1] > tries)) && tries=${BASH_REMATCH[1]}
  done
  [[ $count == --try ]] && ((tries++))
  [[ $count == --untry ]] && ((tries > 1)) && ((tries--))
  [[ " ${parked[*]} " == *" $label "* ]] && tries=1
  target=("$label")
  ((tries > 1)) && target+=("$try$tries")
fi

apply "$number" "${target[@]}"
if ! pr=$(gh pr list --head "$prefix$number" --state open --json number --jq '.[0].number // empty' 2>&1); then
  printf "mark: #%s's open PR not labelled %s: %s\n" "$number" "$label" "$(printf '%s' "$pr" | head -n 1 | cut -c 1-120)" >&2
  pr=""
fi
[[ -n $pr ]] && apply "$pr" "${target[@]}"
printf 'mark: #%s is at %s%s\n' "$number" "$(IFS=,; printf '%s' "${target[*]}" | sed 's/,/, /g')" "${pr:+, and so is PR #$pr}"
