#!/bin/bash
set -uo pipefail

usage="close-note: usage: close-note <issue number>"

issue=${1:-}
if [[ $# -ne 1 || ! $issue =~ ^[0-9]+$ ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

first_line() { printf '%s' "$1" | head -n 1 | cut -c 1-120; }

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
declare -A spelt
for key in NOTE TICKET SPEC labels; do
  if ! spelt[$key]=$("$here/spelled" "$key" 2>&1); then
    printf 'close-note: the labels could not be read: %s\n' "$(first_line "${spelt[$key]}")" >&2
    exit 1
  fi
done

if ! labels=$(gh issue view "$issue" --json labels --jq '.labels[].name' 2>&1); then
  printf 'close-note: #%s not read: %s\n' "$issue" "$(first_line "$labels")" >&2
  exit 1
fi
holding=$(awk -F'\t' -v built="${spelt[TICKET]}" -v sliced="${spelt[SPEC]}" '
  NR == FNR { if ($2 != "kind" || $1 == built || $1 == sliced) held[$1]; next }
  $0 in held { print; exit }
' <(printf '%s\n' "${spelt[labels]}") <(printf '%s\n' "$labels"))
if [[ -n $holding ]] && ! grep -qxF "${spelt[NOTE]}" <<<"$labels"; then
  printf 'close-note: #%s is labelled %s, so the machine closes it; a ticket closes when its PR merges\n' "$issue" "$holding" >&2
  exit 1
fi
if ! said=$(gh issue close "$issue" --reason completed 2>&1); then
  printf 'close-note: #%s not closed: %s\n' "$issue" "$(first_line "$said")" >&2
  exit 1
fi
printf 'close-note: #%s is closed\n' "$issue"
