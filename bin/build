#!/bin/bash
set -uo pipefail

usage="build: usage: build <ticket number>"

ticket=${1:-}
if [[ $# -ne 1 || ! $ticket =~ ^[0-9]+$ ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
log="$(git rev-parse --path-format=absolute --git-common-dir)/machine-logs/build-$ticket.log"
mkdir -p "${log%/*}"
[[ $log == "$top/"* ]] && shown="${log#"$top/"}" || shown="$log"

if verdict=$(node "$src/builder.ts" "$ticket" 2>"$log"); then
  printf 'build: #%s %s\n' "$ticket" "$verdict"
  exit 0
fi
printf 'build: #%s ended red, %s; log %s\n' "$ticket" "$(head -1 "$log")" "$shown" >&2
exit 1
