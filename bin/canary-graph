#!/bin/bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/node-on-path.sh
. "$HERE/node-on-path.sh"
node_on_path || { echo "canary-graph: no node on PATH" >&2; exit 2; }
OWNER="$(gh api user --jq .login)"
REPO="$OWNER/canary-graph-noop"
WATCH_SECS=180
RUNAWAY_CAP=200

log() { printf 'canary-graph: %s\n' "$*" >&2; }
die() { log "$*"; exit 2; }

cmd="${1:-run}"
case "$cmd" in run|down) ;; *) die "usage: bin/canary-graph [run|down]" ;; esac

if [ "$cmd" = "down" ]; then
  if gh api "repos/$REPO" --jq .name >/dev/null 2>&1; then
    gh repo delete "$REPO" --yes >/dev/null
    log "deleted $REPO"
  else
    log "nothing to delete -- $REPO does not exist"
  fi
  exit 0
fi

OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT
SEEN_FILE="$OUT/seen-runs.json"

log "generating stub workflows"
node "$HERE/canary-graph-gen.mjs" "$OUT"

if gh api "repos/$REPO" --jq .name >/dev/null 2>&1; then
  log "deleting existing $REPO for a clean slate"
  gh repo delete "$REPO" --yes >/dev/null
fi
log "creating $REPO"
gh repo create "$REPO" --private --description "Graph-noop canary: every lane stubbed to log+forward, proving the trigger graph alone." >/dev/null
for _ in $(seq 30); do gh api "repos/$REPO" --jq .name >/dev/null 2>&1 && break; sleep 2; done

mkdir -p "$OUT/docs/adr"
echo "# seed" > "$OUT/docs/adr/0001-seed.md"
echo "seed" > "$OUT/CODING_STANDARDS.md"
echo "// seed" > "$OUT/eslint.config.js"
echo '{"name":"canary-graph-noop","private":true}' > "$OUT/package.json"

rm -rf "$OUT/.git"
git -C "$OUT" init -q -b main
git -C "$OUT" -c user.email="graph-noop@local" -c user.name="graph-noop" add -A
git -C "$OUT" -c user.email="graph-noop@local" -c user.name="graph-noop" commit -q -m "graph-noop: seed"
git -C "$OUT" remote add origin "https://github.com/$REPO.git"
log "pushing seed (fires Verify / Back-stamp / Missing-trailer counter / Decline on revert)"
git -C "$OUT" push -q -u origin main

for l in fuzzy to-build prd "graph-noop:shaped" "graph-noop:accepted" to-spec; do
  gh label create "$l" -R "$REPO" --color eeeeee >/dev/null 2>&1 || true
done

log "firing session-captured (Audit, Walk home, Run watchdog, Dispatch reconcile)"
gh api "repos/$REPO/dispatches" -f event_type=session-captured -f "client_payload[path]=" >/dev/null

log "firing ticket-ready directly (Implement, entering the backbone without the Shape/Spec chain)"
gh api "repos/$REPO/dispatches" -f event_type=ticket-ready -f "client_payload[path]=" >/dev/null

log "seeding an issue and labelling it (Shape -> Shape-accept -> Spec -> To-Tickets)"
issue_url="$(gh issue create -R "$REPO" --title "graph-noop: fuzzy seed" --body "seed for the shape chain" 2>&1 | tail -1)"
issue_a="${issue_url##*/}"
gh issue edit "$issue_a" -R "$REPO" --add-label "fuzzy" >/dev/null

log "firing the to-build hand door directly (Dispatch reconcile)"
issue_d_url="$(gh issue create -R "$REPO" --title "graph-noop: to-build seed" --body "seed for the hand door" 2>&1 | tail -1)"
issue_d="${issue_d_url##*/}"
gh issue edit "$issue_d" -R "$REPO" --add-label "to-build" >/dev/null

log "closing a prd-labelled issue (Ratify on PRD close)"
issue_b_url="$(gh issue create -R "$REPO" --title "graph-noop: prd seed" --body "seed for ratify-on-prd-close" --label prd 2>&1 | tail -1)"
issue_b="${issue_b_url##*/}"
gh issue close "$issue_b" -R "$REPO" >/dev/null

log "opening and closing a pull request (Ratify release)"
git -C "$OUT" checkout -q -b graph-noop-pr
echo "pr seed" >> "$OUT/README.md" 2>/dev/null || echo "pr seed" > "$OUT/README.md"
git -C "$OUT" -c user.email="graph-noop@local" -c user.name="graph-noop" add -A
git -C "$OUT" -c user.email="graph-noop@local" -c user.name="graph-noop" commit -q -m "graph-noop: pr seed"
git -C "$OUT" push -q origin graph-noop-pr
pr_url="$(gh pr create -R "$REPO" --base main --head graph-noop-pr --title "graph-noop: pr seed" --body "seed" 2>&1 | tail -1)"
gh pr close "$pr_url" -R "$REPO" >/dev/null

log "watching for ${WATCH_SECS}s -- https://github.com/$REPO/actions"
deadline=$((SECONDS + WATCH_SECS))
echo '[]' > "$SEEN_FILE"
runaway=0
prev_count=0
stable_polls=0
while [ $SECONDS -lt $deadline ]; do
  count=$(gh api "repos/$REPO/actions/runs?per_page=1" --jq '.total_count' 2>/dev/null || echo 0)
  log "runs so far: $count"
  if [ "$count" = "$prev_count" ]; then
    stable_polls=$((stable_polls + 1))
    [ "$stable_polls" -ge 3 ] && { log "run count stable at $count for 3 polls -- graph has drained"; break; }
  else
    stable_polls=0
  fi
  prev_count=$count
  if [ "$count" -ge "$RUNAWAY_CAP" ]; then
    log "RUNAWAY -- $count runs and climbing, deleting $REPO now rather than waiting out the clock"
    gh repo delete "$REPO" --yes >/dev/null 2>&1 || true
    runaway=1
    break
  fi
  sleep 5
done
if [ "$runaway" = "0" ]; then
  gh api --paginate "repos/$REPO/actions/runs?per_page=100" --jq '.workflow_runs[] | {name, event, status, conclusion, created_at, id}' \
    | jq -s '.' > "$SEEN_FILE"
fi

out_copy="$HERE/../.canary-graph-last-run.json"
cp "$SEEN_FILE" "$out_copy"
log "final snapshot written to $out_copy"
if [ "$runaway" = "1" ]; then
  log "verdict: RED (runaway) -- repo deleted, see snapshot for the shape of it before the cap tripped"
  exit 1
else
  log "repo left in place for inspection: https://github.com/$REPO -- bin/canary-graph down to delete it"
fi
