#!/bin/bash
set -uo pipefail

usage="save: usage: save <ticket number>"

ticket=${1:-}
if [[ $# -ne 1 || ! $ticket =~ ^[0-9]+$ ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

if ! prefix=$("${BASH_SOURCE[0]%/*}/spelled" TICKET_PREFIX 2>&1); then
  printf 'save: the branch prefix could not be read: %s\n' "$(printf '%s' "$prefix" | head -n 1 | cut -c 1-120)" >&2
  exit 1
fi
src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
branch="$prefix$ticket"
logs="$(git rev-parse --path-format=absolute --git-common-dir)/machine-logs"
log="$logs/save-$ticket.log"
mkdir -p "${log%/*}"
rm -f "$log"
[[ $log == "$top/"* ]] && shown="${log#"$top/"}" || shown="$log"
err=$(mktemp)
trap 'rm -f "$err"' EXIT

call() {
  if ! said=$("$@" 2>"$err"); then
    { printf -- '--- %s ---\n%s\n' "$*" "$said"; cat "$err"; } >>"$log"
    return 1
  fi
}

stopped() {
  tmp=$(mktemp)
  { printf '1 refusals, stopped at: %s\n' "$1"; cat "$log" 2>/dev/null; } >"$tmp"
  mv "$tmp" "$log"
}

call git push --no-verify --quiet origin "refs/heads/$branch:refs/heads/$branch" || {
  stopped "Save: the push is refused"
  printf 'save: #%s kept on %s here, the push failed, so no PR was opened; log %s\n' "$ticket" "$branch" "$shown" >&2
  exit 1
}
head=$(git rev-parse "refs/heads/$branch")

opened() {
  call gh issue view "$ticket" --json body,title --jq '.title + "\u0001" + .body' || return 1
  title=${said%%$'\x01'*}
  body_text=${said#*$'\x01'}
  consent=$(printf '%s' "$body_text" | node "$src/consent-only-quote.ts")
  body=$(printf 'Builds #%s\n\n%s\n' "$ticket" "$consent")
  if call gh pr create --base main --head "$branch" --title "$title" --body "$body"; then
    url=$said
  else
    call gh pr view "$branch" --json state,url --jq 'select(.state == "OPEN").url' || return 1
    [[ -n $said ]] || return 1
    url=$said
  fi
  call gh pr merge "$branch" --auto --merge --match-head-commit "$head"
}

if ! opened; then
  if grep -q 'Auto merge is not allowed for this repository' "$err"; then
    repo=${GH_REPO:-$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)}
    stopped "Save: the repo has auto-merge off"
    printf "save: #%s's PR is open, but %s has auto-merge off, the repo's fault and not the ticket's: run bin/enrol %s\n" "$ticket" "$repo" "$repo" >&2
    exit 3
  fi
  stopped "Save: the PR is not open with auto-merge on"
  printf 'save: #%s pushed to %s, but its PR is not open with auto-merge on; log %s\n' "$ticket" "$branch" "$shown" >&2
  exit 1
fi
printf 'save: #%s pushed to %s, %s merges once its checks pass\n' "$ticket" "$branch" "$url"
