#!/bin/bash
set -uo pipefail

usage="save: usage: save <ticket number>"

ticket=${1:-}
if [[ $# -ne 1 || ! $ticket =~ ^[0-9]+$ ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
branch="ticket/$ticket"
logs="$(git rev-parse --path-format=absolute --git-common-dir)/machine-logs"
log="$logs/save-$ticket.log"
mkdir -p "${log%/*}"
rm -f "$log"
[[ $log == "$top/"* ]] && shown="${log#"$top/"}" || shown="$log"
err=$(mktemp)
trap 'rm -f "$err"' EXIT

call() {
  if ! said=$("$@" 2>"$err"); then
    { printf -- '--- %s ---\n%s\n' "$*" "$said"; cat "$err"; } >>"$log"
    return 1
  fi
}

stopped() {
  tmp=$(mktemp)
  { printf '1 refusals, stopped at: %s\n' "$1"; cat "$log" 2>/dev/null; } >"$tmp"
  mv "$tmp" "$log"
}

call git push --no-verify --quiet origin "refs/heads/$branch:refs/heads/$branch" || {
  stopped "Save: the push is refused"
  printf 'save: #%s kept on %s here, the push failed, so no PR was opened; log %s\n' "$ticket" "$branch" "$shown" >&2
  exit 1
}
head=$(git rev-parse "refs/heads/$branch")

opened() {
  call gh issue view "$ticket" --json title --jq .title || return 1
  meter=$(node "$src/reads-outside-brief.ts" "$logs" "$top" "$ticket")
  body=$(printf 'Builds #%s\n\n%s\n' "$ticket" "$meter")
  if ! call gh pr create --base main --head "$branch" --title "$said" --body "$body"; then
    call gh pr view "$branch" --json state,url --jq 'select(.state == "OPEN").url' || return 1
    [[ -n $said ]] || return 1
  fi
  url=$said
  call gh pr merge "$branch" --auto --merge --match-head-commit "$head"
}

if ! opened; then
  stopped "Save: the PR is not open with auto-merge on"
  printf 'save: #%s pushed to %s, but its PR is not open with auto-merge on; log %s\n' "$ticket" "$branch" "$shown" >&2
  exit 1
fi
printf 'save: #%s pushed to %s, %s merges once its checks pass\n' "$ticket" "$branch" "$url"
