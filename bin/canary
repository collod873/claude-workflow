#!/bin/bash
# The canary loop, one iteration: push, fire, watch, summarise.
#
#   bin/canary prove [--lane <name>] [--no-wip] [--timeout <s>]   → 0 green · 1 red · 2 could not run
#   bin/canary up                                                 create the target and its runner
#   bin/canary down                                               destroy them and the branch they were named for
#   bin/canary reset-cap                                          clear the consecutive-red counter
#
# A machine change is proven on a canary target before it lands (ADR-0146): a private repository
# whose stubs pin this session's branch and whose lane runs on a self-hosted runner here. This
# script is the one command a session runs in a loop — it never edits; the session reads the
# summary, fixes, and runs it again. Five reds in a row and it refuses to run a sixth, because a
# loop that is not converging is the owner's problem, not the runner's.
#
# Identity is the branch of the worktree this runs in: branch `x/y` → canary branch `canary/x-y`
# → repository `<owner>/canary-x-y`. A branch already named `canary/<id>` keeps its id. It refuses
# `main`, a detached HEAD, and the primary checkout, because two sessions in one checkout share a
# HEAD and a working tree and the push below would carry both.
#
# `up` is idempotent and `prove` calls it, so a session's first loop provisions everything it
# needs — the private target, its seed, a runner registered against it and running. There is no
# one-time install to do by hand first: a hand step per session is exactly why one canary existed
# on the day N sessions in parallel was the point of the design. The runner gets a `HOME` and a
# `PATH` of its own, because one started under yours would hand every lane your `~/.claude` hooks,
# your `~/bin` (where `adr-check` lives — ADR-0097) and your `gh` credentials. That is the floor;
# the container image ADR-0146 defers is the ceiling.
#
# **A green that does not print the machine SHA against the branch head is not a green.** Run
# 33706756013 passed with the machine checked out at `main` under the branch's YAML. So the
# summary always reads the machine checkout's SHA out of the run log and compares it to the commit
# just pushed; a mismatch is red whatever the run's own conclusion says, and so is a job that ran
# anywhere but the `canary` runner.
#
# Absolute interpreter for the same reason `bin/gauntlet` gives: this runs from shells nobody
# logged into.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=bin/node-on-path.sh
. "$repo_root/bin/node-on-path.sh"
node_on_path || exit 2

RUNNER_LABEL="canary"
CAP=5

usage() {
  sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

log() { printf 'canary: %s\n' "$*" >&2; }
die() { log "$*"; exit 2; }

put_file() { # path message content [sha] → "<commit sha> <blob sha>"
  local args=(-X PUT "repos/$canary_repo/contents/$1" -f "message=$2" -f "content=$(printf '%s\n' "$3" | base64 -w0)" -f "branch=$target_branch")
  [ -n "${4:-}" ] && args+=(-f "sha=$4")
  gh api "${args[@]}" --jq '"\(.commit.sha) \(.content.sha)"'
}

# ---------------------------------------------------------------- arguments
cmd="${1:-}"
case "$cmd" in prove|up|down|reset-cap) ;; *) usage ;; esac
shift
lane="verify"
wip=1
timeout_s=900
while [ $# -gt 0 ]; do
  case "$1" in
    --lane) lane="$2"; shift 2 ;;
    --no-wip) wip=0; shift ;;
    --timeout) timeout_s="$2"; shift 2 ;;
    *) usage ;;
  esac
done

# ---------------------------------------------------------------- identity
# In a worktree `--git-dir` is `<common>/worktrees/<name>`; in the primary checkout the two are
# the same directory. Both resolved to physical paths, since one is absolute and one may not be.
git_dir="$(cd "$repo_root" && cd "$(git rev-parse --git-dir)" && pwd -P)"
common_dir="$(cd "$repo_root" && cd "$(git rev-parse --git-common-dir)" && pwd -P)"
if [ "$git_dir" = "$common_dir" ]; then
  die "this is the primary checkout — run the canary from a worktree (git worktree add <dir> -b <branch>) so no other session shares its HEAD"
fi
branch="$(git -C "$repo_root" symbolic-ref --short -q HEAD || true)"
[ -n "$branch" ] || die "detached HEAD — a canary is named by its branch"
[ "$branch" != "main" ] || die "on main — a canary proves a branch before it lands, never main itself"
id="${branch#canary/}"
id="${id//\//-}"
canary_branch="canary/$id"
origin_url="$(git -C "$repo_root" remote get-url origin)"
machine_repo="$(sed -E 's#^(https://github.com/|git@github.com:)##; s#\.git$##' <<<"$origin_url")"
owner="${machine_repo%%/*}"
canary_repo="$owner/canary-$id"
state_dir="$git_dir/canary"
mkdir -p "$state_dir"
cap_file="$state_dir/reds"
fingerprint_file="$state_dir/last-fingerprint"

# ---------------------------------------------------------------- provisioning
# One runner per canary, named by the same id, all carrying the `canary` label: the label is what
# the stub asks for and the registration is per repository, so N of them never contend for one
# another's jobs. No organisation is involved — the account has none, and per-repository
# registration is what the design assumed because of it.
runner_root="$HOME/canary-runner"
runner_dir="$runner_root/$id"
runner_home="$runner_root/home"
runner_cache="$runner_root/cache"
target_branch=""

repo_exists() { gh api "repos/$1" --jq .name >/dev/null 2>&1; }
runner_online() {
  [ "$(gh api "repos/$canary_repo/actions/runners" \
    --jq "[.runners[] | select(.status==\"online\") | select(any(.labels[]; .name==\"$RUNNER_LABEL\"))] | length")" -gt 0 ]
}
runner_running() { pgrep -f "$runner_dir/bin/Runner.Listener" >/dev/null 2>&1; }

ensure_repo() {
  if ! repo_exists "$canary_repo"; then
    log "creating $canary_repo"
    gh repo create "$canary_repo" --private --add-readme \
      --description "Canary target for $canary_branch. Created by bin/canary up; delete with bin/canary down." >/dev/null
    # A repository the API has just made 404s for a beat, and every seed write below needs it.
    for _ in $(seq 30); do repo_exists "$canary_repo" && break; sleep 2; done
    repo_exists "$canary_repo" || die "created $canary_repo but the API still will not resolve it"
  fi
  target_branch="$(gh api "repos/$canary_repo" --jq .default_branch)"
}

seed_file() { # path content — written only where absent
  gh api "repos/$canary_repo/contents/$1?ref=$target_branch" --jq .sha >/dev/null 2>&1 && return 0
  put_file "$1" "canary: seed $1" "$2" >/dev/null
  log "seeded $1"
}

# The smallest honest target: three contract slots and one test, so the machine has something to
# check that is provably not itself. A canary that has since drifted is the session's business —
# `down` is how you get a clean one, not a reseed that would fight the lane it is proving.
ensure_seed() {
  seed_file package.json '{
  "name": "canary-'"$id"'",
  "private": true,
  "description": "The smallest honest target: three contract slots and one test, so the machine has something to check that is provably not itself.",
  "scripts": {
    "typecheck": "true",
    "lint": "true",
    "test": "node --test"
  }
}'
  seed_file package-lock.json '{
  "name": "canary-'"$id"'",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "canary-'"$id"'"
    }
  }
}'
  # Committed, not probed: `bin/gauntlet push` regenerates the contract and fails on disagreement
  # (ADR-0056), so the seed has to carry the answers the probe gives for this shape.
  seed_file .claude/contract.json '{
  "stop": {
    "cmd": null,
    "why": "no Stop hook in .claude/settings.json, and no turn-end check at .claude/hooks/stop-gate.sh"
  },
  "test": {
    "cmd": "npm test",
    "why": "package.json#scripts.test (node --test)"
  },
  "test_one": {
    "cmd": null,
    "why": "no known single-file form for the installed test runner"
  },
  "test_related": {
    "cmd": null,
    "why": "no known related-tests form for the installed test runner"
  },
  "typecheck": {
    "cmd": "npm run typecheck",
    "why": "package.json#scripts.typecheck (true)"
  },
  "lint": {
    "cmd": "npm run lint",
    "why": "package.json#scripts.lint (true)"
  },
  "all": {
    "cmd": null,
    "why": "no aggregate script found among package.json#scripts.{check,verify,ci}"
  }
}'
  seed_file tests/smoke.test.mjs 'import test from "node:test";
import assert from "node:assert/strict";

test("the seed has a test the machine can run", () => {
  assert.equal(1 + 1, 2);
});'
}

install_runner() {
  mkdir -p "$runner_home" "$runner_cache" "$runner_dir"
  local ver tarball
  ver="$(gh api repos/actions/runner/releases/latest --jq '.tag_name | ltrimstr("v")')"
  tarball="$runner_cache/actions-runner-linux-x64-$ver.tar.gz"
  if [ ! -s "$tarball" ]; then
    log "downloading runner $ver once into $runner_cache — every later canary extracts this copy"
    # Downloaded to a name only this process uses, then moved into place: two sessions provisioning
    # their first canary at the same moment would otherwise write one file and both extract it.
    curl -fsSL "https://github.com/actions/runner/releases/download/v$ver/actions-runner-linux-x64-$ver.tar.gz" \
      -o "$tarball.$$.part" || die "could not download runner $ver"
    mv "$tarball.$$.part" "$tarball"
  fi
  tar -xzf "$tarball" -C "$runner_dir"
  log "registering runner '$id' on $canary_repo"
  ( cd "$runner_dir" && HOME="$runner_home" ./config.sh --unattended --replace \
      --url "https://github.com/$canary_repo" \
      --token "$(gh api -X POST "repos/$canary_repo/actions/runners/registration-token" --jq .token)" \
      --name "$id" --labels "$RUNNER_LABEL" --work _work >/dev/null ) \
    || die "config.sh refused the registration — see $runner_dir"
}

start_runner() {
  # An explicit PATH, not the launching shell's: whoever runs `prove` — you, a hook, a session with
  # a different node on it — the lane has to see the same tools. `node` and `gh` are named because
  # a self-hosted runner has neither preinstalled the way a hosted one does, and both live under
  # `~/.local`; `~/bin` is left off deliberately — it holds `adr-check` (ADR-0097).
  local runner_path gh_bin
  gh_bin="$(command -v gh)" || die "no gh on PATH — the lanes the runner serves cannot work without it"
  runner_path="$(dirname "$(command -v node)"):$(dirname "$gh_bin"):/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  log "starting runner '$id' (log: $runner_dir.log)"
  # `setsid --fork`, not `setsid` or `nohup … &`: bare `setsid` execs in place when it is not
  # already a group leader, so the runner stays this script's child and bash waits on it at exit —
  # `bin/canary up` then never returns, and a loop whose one command does not return is no loop.
  # Forking hands it to init, which is also what survives the session that started it.
  ( cd "$runner_dir" \
    && HOME="$runner_home" PATH="$runner_path" setsid --fork ./run.sh >"$runner_dir.log" 2>&1 </dev/null & )
}

ensure_runner() {
  # Both halves, because either alone lies: the API keeps calling a runner online for a while after
  # its process dies (a WSL reset takes every one of them at once), and a process that has just
  # started is not online yet.
  runner_online && runner_running && return 0
  [ -f "$runner_dir/.runner" ] || install_runner
  runner_running || start_runner
  for _ in $(seq 30); do
    sleep 2
    runner_online && { log "runner '$id' online"; return 0; }
  done
  die "runner '$id' did not come online in 60 s — tail $runner_dir.log"
}

canary_up() {
  ensure_repo
  ensure_seed
  ensure_runner
}

canary_down() {
  if [ -f "$runner_dir/.runner" ]; then
    pkill -f "$runner_dir/run.sh" >/dev/null 2>&1 || true
    pkill -f "$runner_dir/bin/Runner.Listener" >/dev/null 2>&1 || true
    sleep 1
    local token
    token="$(gh api -X POST "repos/$canary_repo/actions/runners/remove-token" --jq .token 2>/dev/null || true)"
    if [ -n "$token" ]; then
      ( cd "$runner_dir" && HOME="$runner_home" ./config.sh remove --token "$token" >/dev/null 2>&1 ) \
        || log "the runner would not deregister itself — removing its directory anyway"
    fi
    log "removed runner '$id'"
  fi
  rm -rf "$runner_dir" "$runner_dir.log"
  if repo_exists "$canary_repo"; then
    gh repo delete "$canary_repo" --yes && log "deleted $canary_repo"
  fi
  git -C "$repo_root" push -q origin --delete "$canary_branch" >/dev/null 2>&1 \
    && log "deleted $canary_branch on $machine_repo" || true
  rm -rf "$state_dir"
  log "down: nothing named $id is left but this worktree and its branch"
}

if [ "$cmd" = "up" ]; then
  canary_up
  log "up: $canary_repo seeded, runner '$id' online"
  exit 0
fi
if [ "$cmd" = "down" ]; then
  canary_down
  exit 0
fi

if [ "$cmd" = "reset-cap" ]; then
  rm -f "$cap_file" "$fingerprint_file"
  log "cap reset for $id"
  exit 0
fi
reds="$(cat "$cap_file" 2>/dev/null || echo 0)"
if [ "$reds" -ge "$CAP" ]; then
  die "$reds reds in a row on $id — the loop is not converging; stop, rethink, then bin/canary prove --reset-cap"
fi

log "id=$id  branch=$branch → $canary_branch  target=$canary_repo  lane=$lane"

# ---------------------------------------------------------------- fire plan
# How `--lane $lane` wakes, derived from that lane's own caller YAML rather than a hand-written
# lane→fire table — `canary-fire-plan.ts` reads `$stub_path`'s `on:` block with the one YAML
# reader this repo already has (`read-workflow.ts`) and answers with the fire this script should
# perform. Computed before the push below so a lane bin/canary cannot fire — a workflow_run-only
# lane (ADR-0149), or a trigger shape it does not know — refuses fast, before spending a push and
# a provision on a canary that could never have run.
stub_path=".github/workflows/$lane-caller.yml"
[ -f "$repo_root/$stub_path" ] || die "no $stub_path in the machine — lane '$lane' has no caller stub"
plan_json="$(node "$repo_root/.Workflow/agent-workflows/shared/canary-fire-plan.ts" "$lane")" \
  || die "could not derive a fire for lane '$lane' — see above"
fire_kind="$(jq -r .kind <<<"$plan_json")"
[ "$fire_kind" != "refuse" ] || die "$(jq -r .reason <<<"$plan_json")"
fire_event="$(jq -r '.event // empty' <<<"$plan_json")"
fire_event_type="$(jq -r '.eventType // empty' <<<"$plan_json")"
log "lane '$lane' wakes on $fire_kind${fire_event_type:+ ($fire_event_type)}"

# ---------------------------------------------------------------- push
if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
  if [ "$wip" = "1" ]; then
    git -C "$repo_root" add -A
    git -C "$repo_root" commit -q --no-verify -m "canary: wip"
    log "committed the working tree as wip (squash before landing)"
  else
    die "working tree is dirty and --no-wip was given"
  fi
fi
head="$(git -C "$repo_root" rev-parse HEAD)"
# `CANARY_EXPECT_HEAD`, when set, is what the summary compares the machine checkout against
# instead of HEAD — the one seam for proving that a run whose machine SHA is not the branch head
# comes out red whatever GitHub concluded. Never set it outside that demonstration.
expect_head="${CANARY_EXPECT_HEAD:-$head}"
log "pushing $head to $canary_branch (the pre-push gauntlet runs here)"
push_log="$state_dir/push.log"
if ! git -C "$repo_root" push -q --force origin "HEAD:refs/heads/$canary_branch" >"$push_log" 2>&1; then
  grep -E "^(--- |gauntlet: |error: | FAIL |×| ❯ )" "$push_log" | tail -20 >&2
  die "the local gauntlet refused the push — fix that first; nothing was fired (full output: $push_log)"
fi

# ---------------------------------------------------------------- up (idempotent)
canary_up

# The stub the canary must carry: this machine's own stub, re-pinned to the session's branch and
# told which runner and machine ref to use. Written only when it differs. For a push-triggered
# lane that write is itself the fire (a second push would only queue a second run behind it); every
# other lane wakes on a door this stub-write does not ring, so its fire happens further down,
# always exactly once, after the stub is confirmed in place.
# `runner`/`machine_ref` are merged into the job's own `with:` block, not appended as a second
# one: a stub whose `uses:` already carries a `with:` (e.g. fixer-caller.yml's `run_id`/`test_dir`)
# would otherwise get two `with:` keys in one YAML mapping — invalid, so GitHub fails the whole
# workflow file at parse time and schedules no job at all, which reads as a false red with no
# job ever having run. A stub with no `with:` block (verify-caller.yml) still gets one appended.
expected_stub="$(sed -E "s#(uses: $machine_repo/\.github/workflows/$lane\.yml)@main#\1@$canary_branch#" "$repo_root/$stub_path" \
  | awk -v runner="$RUNNER_LABEL" -v ref="$canary_branch" -v usline="uses: $machine_repo/.github/workflows/$lane.yml@$canary_branch" '
    BEGIN { pending = 0; inserted = 0 }
    {
      if (pending) {
        pending = 0
        if ($0 ~ /^[ \t]*with:[ \t]*$/) {
          print
          indent = $0
          sub(/with:.*/, "", indent)
          print indent "  runner: " runner
          print indent "  machine_ref: " ref
          inserted = 1
          next
        } else {
          indent = prevline
          sub(/uses:.*/, "", indent)
          print indent "with:"
          print indent "  runner: " runner
          print indent "  machine_ref: " ref
          inserted = 1
        }
      }
      print
      if (index($0, usline) > 0) { pending = 1; prevline = $0 }
    }
    END {
      if (pending && !inserted) {
        indent = prevline
        sub(/uses:.*/, "", indent)
        print indent "with:"
        print indent "  runner: " runner
        print indent "  machine_ref: " ref
      }
    }
  ')"
remote_stub_json="$(gh api "repos/$canary_repo/contents/$stub_path?ref=$target_branch" 2>/dev/null || echo '{}')"
# `base64 -d`, not jq's `@base64d`: the API wraps its base64 at 60 columns and jq refuses the
# newlines, which read as "no stub there" and wrote an identical one — a commit with no diff,
# which fires nothing under the stub's `paths-ignore` (exactly the empty-commit case).
remote_stub="$(jq -r '.content // ""' <<<"$remote_stub_json" | base64 -d 2>/dev/null || true)"
remote_stub_sha="$(jq -r '.sha // empty' <<<"$remote_stub_json")"

fire_sha=""
if [ "$remote_stub" != "$expected_stub" ]; then
  read -r stub_commit stub_blob <<<"$(put_file "$stub_path" "canary: pin $lane to $canary_branch on the $RUNNER_LABEL runner" "$expected_stub" "$remote_stub_sha")"
  if [ "$fire_kind" = "push" ] && [ "$stub_blob" != "$remote_stub_sha" ]; then
    fire_sha="$stub_commit"
    log "stub written on $canary_repo ($fire_sha) — that commit is the fire"
  elif [ "$fire_kind" = "push" ]; then
    log "stub PUT changed nothing (blob $stub_blob unchanged) — firing separately"
  else
    log "stub written on $canary_repo ($stub_commit) — pin only; $lane wakes on $fire_kind, not push"
  fi
fi

# ---------------------------------------------------------------- reset
for run in $(gh run list -R "$canary_repo" --json databaseId,status --jq '.[] | select(.status=="in_progress" or .status=="queued" or .status=="waiting") | .databaseId'); do
  gh run cancel "$run" -R "$canary_repo" >/dev/null 2>&1 || true
  log "cancelled stale run $run"
done

# ---------------------------------------------------------------- fire
# Exactly one fire per iteration (ADR-0146's property, carried to every trigger kind, not just
# push): a push either lands as the stub-pin commit above or as the `.canary-fire` write below,
# never both; every other kind below is a single API call made once, right here. None of them
# move the target repo's default branch, so `before_time` is what tells the watch step a run this
# call caused from one already sitting in the repo's history at the same ref.
ensure_label() { # name — idempotent; issues:labeled needs a label to exist before it can be added
  gh label create "$1" -R "$canary_repo" --color eeeeee >/dev/null 2>&1 || true
}
seed_issue() { # why → issue number, on stdout
  local url
  url="$(gh issue create -R "$canary_repo" --title "canary: fire $lane ($1)" \
    --body "Seed issue created by bin/canary to fire the '$lane' lane." 2>&1 | tail -1)"
  echo "${url##*/}"
}

before_time="$(date -u +%FT%TZ)"
case "$fire_kind" in
  push)
    if [ -z "$fire_sha" ]; then
      fire_json="$(gh api "repos/$canary_repo/contents/.canary-fire?ref=$target_branch" 2>/dev/null || echo '{}')"
      read -r fire_sha _ <<<"$(put_file ".canary-fire" "canary: fire $lane at $head" "$(date -u +%FT%TZ) machine=$head" "$(jq -r '.sha // empty' <<<"$fire_json")")"
    fi
    log "fired: $canary_repo@$fire_sha (push)"
    ;;
  workflow_dispatch)
    gh api -X POST "repos/$canary_repo/actions/workflows/$(basename "$stub_path")/dispatches" -f "ref=$target_branch" >/dev/null
    log "fired: $canary_repo workflow_dispatch on $stub_path@$target_branch"
    ;;
  repository_dispatch)
    gh api -X POST "repos/$canary_repo/dispatches" -f "event_type=$fire_event_type" -f "client_payload[canary]=$id" >/dev/null
    log "fired: $canary_repo repository_dispatch event_type=$fire_event_type"
    ;;
  issues_labeled)
    ensure_label "canary-fire"
    issue_num="$(seed_issue "issues:labeled")"
    gh issue edit "$issue_num" -R "$canary_repo" --add-label "canary-fire" >/dev/null
    log "fired: $canary_repo issue #$issue_num labeled canary-fire"
    ;;
  issues_closed)
    issue_num="$(seed_issue "issues:closed")"
    gh issue close "$issue_num" -R "$canary_repo" >/dev/null
    log "fired: $canary_repo issue #$issue_num closed"
    ;;
  pull_request_closed)
    pr_branch="canary-fire-$(date -u +%s)"
    base_sha="$(gh api "repos/$canary_repo/git/ref/heads/$target_branch" --jq .object.sha)"
    gh api "repos/$canary_repo/git/refs" -f "ref=refs/heads/$pr_branch" -f "sha=$base_sha" >/dev/null
    gh api -X PUT "repos/$canary_repo/contents/.canary-fire" \
      -f "message=canary: fire $lane" -f "content=$(printf '%s\n' "fired at $before_time" | base64 -w0)" -f "branch=$pr_branch" >/dev/null
    pr_url="$(gh pr create -R "$canary_repo" --base "$target_branch" --head "$pr_branch" \
      --title "canary: fire $lane" --body "Seed pull request created by bin/canary to fire the '$lane' lane." 2>&1 | tail -1)"
    gh pr close "$pr_url" -R "$canary_repo" >/dev/null
    log "fired: $canary_repo PR ${pr_url##*/} closed"
    ;;
  *)
    die "internal error: canary-fire-plan.ts returned an unhandled kind '$fire_kind'"
    ;;
esac

# ---------------------------------------------------------------- watch
run_id=""
deadline=$((SECONDS + 120))
if [ "$fire_kind" = "push" ]; then
  while [ -z "$run_id" ]; do
    run_id="$(gh api "repos/$canary_repo/actions/runs?head_sha=$fire_sha" --jq '.workflow_runs[0].id // empty')"
    [ -n "$run_id" ] && break
    [ $SECONDS -lt $deadline ] || die "the push fired nothing in 120 s — does $stub_path trigger on push to $target_branch, and did the change touch a path outside paths-ignore?"
    sleep 3
  done
else
  # No new commit moves the ref for these kinds, so `head_sha` cannot pick the run out — filtered
  # by the GitHub event name the fire actually was, and by having arrived no earlier than the fire.
  while [ -z "$run_id" ]; do
    run_id="$(gh api "repos/$canary_repo/actions/runs?event=$fire_event&per_page=15" \
      --jq --arg t "$before_time" '[.workflow_runs[] | select(.created_at >= $t)] | sort_by(.created_at) | .[0].id // empty')"
    [ -n "$run_id" ] && break
    [ $SECONDS -lt $deadline ] || die "the $fire_kind fire triggered nothing in 120 s — does $stub_path actually declare that trigger on $canary_repo's default branch?"
    sleep 3
  done
fi
log "run $run_id — https://github.com/$canary_repo/actions/runs/$run_id"
deadline=$((SECONDS + timeout_s))
status=""
while [ "$status" != "completed" ]; do
  status="$(gh api "repos/$canary_repo/actions/runs/$run_id" --jq .status)"
  [ "$status" = "completed" ] && break
  [ $SECONDS -lt $deadline ] || { gh run cancel "$run_id" -R "$canary_repo" >/dev/null 2>&1 || true; die "run $run_id still $status after ${timeout_s}s — cancelled"; }
  sleep 5
done
conclusion="$(gh api "repos/$canary_repo/actions/runs/$run_id" --jq .conclusion)"

# ---------------------------------------------------------------- summarise
jobs_json="$(gh api "repos/$canary_repo/actions/runs/$run_id/jobs")"
log_file="$state_dir/run-$run_id.log"
for _ in 1 2 3 4 5; do
  if gh run view "$run_id" -R "$canary_repo" --log >"$log_file" 2>/dev/null && [ -s "$log_file" ]; then break; fi
  sleep 3
done
plain="$(cut -f3- "$log_file" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //')"

# The SHA each checkout actually landed on: `actions/checkout` logs `Syncing repository: <repo>`
# and, after the checkout, `git log -1 --format=%H` followed by the SHA on its own line.
sha_after_sync() {
  awk -v repo="$1" '
    $0 == "Syncing repository: " repo { armed = 1; next }
    armed && /^[0-9a-f]{40}$/ { print; exit }
  ' <<<"$plain"
}
machine_sha="$(sha_after_sync "$machine_repo" || true)"
target_sha="$(sha_after_sync "$canary_repo" || true)"
uses_line="$(grep -m1 -E "^Uses: $machine_repo/\.github/workflows/$lane\.yml@" <<<"$plain" || true)"

verdict="green"
reasons=()
[ "$conclusion" = "success" ] || { verdict="red"; reasons+=("run concluded '$conclusion'"); }
if [ -z "$machine_sha" ]; then
  verdict="red"; reasons+=("could not read the machine checkout's SHA from the log — nothing proves which machine ran")
elif [ "$machine_sha" != "$expect_head" ]; then
  verdict="red"; reasons+=("FALSE GREEN: machine ran at ${machine_sha:0:12}, branch head is ${expect_head:0:12}")
fi
ran_jobs="$(jq -r '[.jobs[] | select(.conclusion != "skipped")] | length' <<<"$jobs_json")"
[ "$ran_jobs" -gt 0 ] || { verdict="red"; reasons+=("no job ran — every job was skipped"); }
off_runner="$(jq -r --arg l "$RUNNER_LABEL" '[.jobs[] | select(.conclusion != "skipped") | select((.labels // []) | index($l) | not) | .name] | join(", ")' <<<"$jobs_json")"
[ -z "$off_runner" ] || { verdict="red"; reasons+=("ran off the '$RUNNER_LABEL' runner: $off_runner"); }

failed_steps="$(jq -r '.jobs[] | . as $j | (.steps // [])[] | select(.conclusion=="failure") | "\($j.name) → \(.name)"' <<<"$jobs_json")"
fingerprint="$(printf '%s\n%s\n%s' "$verdict" "${reasons[*]:-}" "$failed_steps" | sha1sum | cut -c1-12)"
same_as_last=0
[ "$(cat "$fingerprint_file" 2>/dev/null || true)" = "$fingerprint" ] && same_as_last=1
printf '%s' "$fingerprint" >"$fingerprint_file"

if [ "$verdict" = "green" ]; then
  rm -f "$cap_file"
else
  echo $((reds + 1)) >"$cap_file"
fi

{
  echo "================================================================ canary: $verdict"
  echo "id            $id"
  echo "lane          $lane"
  echo "branch head   $head"
  echo "machine ran   ${machine_sha:-<unknown>}   $([ "$machine_sha" = "$expect_head" ] && echo '== head ✓' || echo '!= head ✗')"
  echo "target        $canary_repo@${target_sha:-<unknown>}"
  echo "workflow      ${uses_line#Uses: }"
  echo "run           https://github.com/$canary_repo/actions/runs/$run_id   $conclusion"
  jq -r '.jobs[] | "job           \(.name): \(.conclusion)  runner=\(.runner_name // "-") labels=\((.labels // []) | join(","))  \(.started_at // "")..\(.completed_at // "")"' <<<"$jobs_json"
  for r in "${reasons[@]:-}"; do [ -n "$r" ] && echo "why           $r"; done
  if [ -n "$failed_steps" ]; then
    echo "failed steps"
    sed 's/^/              /' <<<"$failed_steps"
    echo "--- last 40 lines of the failed step(s)"
    gh run view "$run_id" -R "$canary_repo" --log-failed 2>/dev/null | cut -f3- | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //' | grep -v '^\s*$' | tail -40
  fi
  if [ "$verdict" != "green" ]; then
    echo "reds in a row $((reds + 1)) of $CAP$([ "$same_as_last" = "1" ] && echo '   — SAME SUMMARY AS LAST TIME: no progress')"
  fi
  echo "log           $log_file"
}

[ "$verdict" = "green" ] && exit 0 || exit 1
