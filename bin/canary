#!/bin/bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=bin/node-on-path.sh
. "$repo_root/bin/node-on-path.sh"
node_on_path || exit 2

CANARY_RUNNER="ubuntu-latest"
CAP=5

usage() {
  cat >&2 <<'USAGE'
usage: bin/canary <command> [options]

  up                       create and seed the canary target, public so hosted runners are free
  token [sk-ant-...]       set CLAUDE_CODE_OAUTH_TOKEN on the machine and the canary at once
  token --clipboard        take the token straight off the clipboard, so it is never typed
  token --from <file>      take the token from a file, so it never reaches a shell history
  prove --lane <lane>      prove one lane's real code at this branch's head
  sweep [--lanes a,b|all]  prove every lane, groups at once, lanes behind one door in turn
  reset-cap                forget the consecutive-red count for every lane
  down                     delete the canary target, its branch, and this canary's state

  --timeout <s>            how long to wait on a run (default 900)
  --no-wip                 refuse a dirty working tree instead of committing it
USAGE
  exit 2
}

log() { printf 'canary: %s\n' "$*" >&2; }
die() { log "$*"; exit 2; }

put_file() { # path message content [sha] → "<commit sha> <blob sha>"
  local args=(-X PUT "repos/$canary_repo/contents/$1" -f "message=$2" -f "content=$(printf '%s\n' "$3" | base64 -w0)" -f "branch=$target_branch")
  [ -n "${4:-}" ] && args+=(-f "sha=$4")
  gh api "${args[@]}" --jq '"\(.commit.sha) \(.content.sha)"'
}

read_clipboard() {
  {
    if command -v powershell.exe >/dev/null 2>&1; then
      powershell.exe -NoProfile -Command Get-Clipboard 2>/dev/null
    elif command -v wl-paste >/dev/null 2>&1; then
      wl-paste 2>/dev/null
    elif command -v xclip >/dev/null 2>&1; then
      xclip -o -selection clipboard 2>/dev/null
    elif command -v pbpaste >/dev/null 2>&1; then
      pbpaste 2>/dev/null
    fi
  } | tr -d '[:space:]'
}

cmd="${1:-}"
case "$cmd" in prove|sweep|token|up|down|reset-cap) ;; *) usage ;; esac
shift
lane="verify"
lanes=""
wip=1
push=1
pin_only=0
timeout_s=900
token_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --lane) lane="$2"; shift 2 ;;
    sk-ant-*) token_arg="$1"; shift ;;
    --from) token_arg="$(tr -d '[:space:]' <"$2")"; shift 2 ;;
    --clipboard) token_arg="$(read_clipboard)"; shift ;;
    --lanes) lanes="$2"; shift 2 ;;
    --no-wip) wip=0; shift ;;
    --no-push) push=0; shift ;;
    --pin-only) pin_only=1; shift ;;
    --timeout) timeout_s="$2"; shift 2 ;;
    *) usage ;;
  esac
done

git_dir="$(cd "$repo_root" && cd "$(git rev-parse --git-dir)" && pwd -P)"
common_dir="$(cd "$repo_root" && cd "$(git rev-parse --git-common-dir)" && pwd -P)"
if [ "$git_dir" = "$common_dir" ]; then
  die "this is the primary checkout; run the canary from a worktree (git worktree add <dir> -b <branch>) so no other session shares its HEAD"
fi
branch="$(git -C "$repo_root" symbolic-ref --short -q HEAD || true)"
[ -n "$branch" ] || die "detached HEAD; a canary is named by its branch"
[ "$branch" != "main" ] || die "on main; a canary proves a branch before it lands, never main itself"
id="${branch#canary/}"
id="${id//\//-}"
canary_branch="canary/$id"
origin_url="$(git -C "$repo_root" remote get-url origin)"
machine_repo="$(sed -E 's#^(https://github.com/|git@github.com:)##; s#\.git$##' <<<"$origin_url")"
owner="${machine_repo%%/*}"
canary_repo="$owner/canary-$id"
state_dir="$git_dir/canary"
mkdir -p "$state_dir"
cap_file="$state_dir/reds-$lane"
fingerprint_file="$state_dir/last-fingerprint-$lane"

target_branch=""

repo_exists() { gh api "repos/$1" --jq .name >/dev/null 2>&1; }

ensure_repo() {
  if ! repo_exists "$canary_repo"; then
    log "creating $canary_repo"
    gh repo create "$canary_repo" --public --add-readme \
      --description "Canary target for $canary_branch. Created by bin/canary up; delete with bin/canary down." >/dev/null
    for _ in $(seq 30); do repo_exists "$canary_repo" && break; sleep 2; done
    repo_exists "$canary_repo" || die "created $canary_repo but the API still will not resolve it"
  fi
  if [ "$(gh api "repos/$canary_repo" --jq .private)" = "true" ]; then
    gh repo edit "$canary_repo" --visibility public --accept-visibility-change-consequences >/dev/null
    log "made $canary_repo public; hosted runners are free and unmetered there, and every lane can prove at once"
  fi
  target_branch="$(gh api "repos/$canary_repo" --jq .default_branch)"
}

seed_file() { # path content, written only where absent
  gh api "repos/$canary_repo/contents/$1?ref=$target_branch" --jq .sha >/dev/null 2>&1 && return 0
  put_file "$1" "canary: seed $1" "$2" >/dev/null
  log "seeded $1"
}

ensure_seed() {
  seed_file package.json '{
  "name": "canary-'"$id"'",
  "private": true,
  "description": "The smallest honest target: three contract slots and one test, so the machine has something to check that is provably not itself.",
  "scripts": {
    "typecheck": "true",
    "lint": "true",
    "test": "node --test"
  }
}'
  seed_file package-lock.json '{
  "name": "canary-'"$id"'",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "canary-'"$id"'"
    }
  }
}'
  seed_file .claude/contract.json '{
  "stop": {
    "cmd": null,
    "why": "no Stop hook in .claude/settings.json, and no turn-end check at .claude/hooks/stop-gate.sh"
  },
  "test": {
    "cmd": "npm test",
    "why": "package.json#scripts.test (node --test)"
  },
  "test_one": {
    "cmd": null,
    "why": "no known single-file form for the installed test runner"
  },
  "test_related": {
    "cmd": null,
    "why": "no known related-tests form for the installed test runner"
  },
  "typecheck": {
    "cmd": "npm run typecheck",
    "why": "package.json#scripts.typecheck (true)"
  },
  "lint": {
    "cmd": "npm run lint",
    "why": "package.json#scripts.lint (true)"
  },
  "all": {
    "cmd": null,
    "why": "no aggregate script found among package.json#scripts.{check,verify,ci}"
  }
}'
  seed_file tests/smoke.test.mjs 'import test from "node:test";
import assert from "node:assert/strict";

test("the seed has a test the machine can run", () => {
  assert.equal(1 + 1, 2);
});'
}

canary_up() {
  ensure_repo
  ensure_seed
}

canary_down() {
  if repo_exists "$canary_repo"; then
    gh repo delete "$canary_repo" --yes && log "deleted $canary_repo"
  fi
  git -C "$repo_root" push -q origin --delete "$canary_branch" >/dev/null 2>&1 \
    && log "deleted $canary_branch on $machine_repo" || true
  rm -rf "$state_dir"
  log "down: nothing named $id is left but this worktree and its branch"
}

if [ "$cmd" = "token" ]; then
  token="${token_arg:-${CLAUDE_CODE_OAUTH_TOKEN:-}}"
  if [ -z "$token" ]; then
    command -v claude >/dev/null || die "no claude on PATH, and no token given; pass one: bin/canary token <token>"
    if [ -t 0 ]; then
      token_tty="/dev/stdin"
    elif { : </dev/tty; } 2>/dev/null; then
      token_tty="/dev/tty"
    else
      die "nothing here can prompt, and setup-token needs a browser it can own. Mint it in your own terminal window: claude setup-token — then bin/canary token <the sk-ant-... it prints>"
    fi
    log "minting a long-lived token; claude owns the terminal until its browser step is done"
    claude setup-token <"$token_tty" || die "claude setup-token did not finish; nothing was written"
    printf 'canary: paste the token it printed: ' >&2
    read -r token <"$token_tty"
  fi
  case "$token" in
    sk-ant-*) ;;
    *) die "that is not a Claude token (they start sk-ant-); nothing was written" ;;
  esac
  for token_repo in "$machine_repo" "$canary_repo"; do
    if repo_exists "$token_repo"; then
      gh secret set CLAUDE_CODE_OAUTH_TOKEN -R "$token_repo" --body "$token" >/dev/null
      log "set CLAUDE_CODE_OAUTH_TOKEN on $token_repo"
    else
      log "no $token_repo yet; skipped"
    fi
  done
  log "token: every agent lane on the machine and the canary now spends the same credential"
  exit 0
fi

if [ "$cmd" = "up" ]; then
  canary_up
  log "up: $canary_repo seeded and public, lanes run on $CANARY_RUNNER"
  exit 0
fi
if [ "$cmd" = "down" ]; then
  canary_down
  exit 0
fi

if [ "$cmd" = "reset-cap" ]; then
  rm -f "$state_dir"/reds-* "$state_dir"/last-fingerprint-*
  log "cap reset for every lane on $id"
  exit 0
fi

commit_wip() {
  [ -n "$(git -C "$repo_root" status --porcelain)" ] || return 0
  [ "$wip" = "1" ] || die "working tree is dirty and --no-wip was given"
  git -C "$repo_root" add -A
  git -C "$repo_root" commit -q --no-verify -m "canary: wip"
  log "committed the working tree as wip (squash before landing)"
}

push_machine() {
  local push_log="$state_dir/push.log"
  log "pushing $(git -C "$repo_root" rev-parse HEAD) to $canary_branch (the pre-push gauntlet runs here)"
  if ! git -C "$repo_root" push -q --force origin "HEAD:refs/heads/$canary_branch" >"$push_log" 2>&1; then
    grep -E "^(--- |gauntlet: |error: | FAIL |×| ❯ )" "$push_log" | tail -20 >&2
    die "the local gauntlet refused the push; fix that first; nothing was fired (full output: $push_log)"
  fi
}

if [ "$cmd" = "sweep" ]; then
  if [ -z "$lanes" ] || [ "$lanes" = "all" ]; then
    mapfile -t sweep_lanes < <(cd "$repo_root/.github/workflows" && ls ./*-caller.yml | sed 's#^\./##; s/-caller\.yml$//')
  else
    mapfile -t sweep_lanes < <(tr ',' '\n' <<<"$lanes")
  fi
  commit_wip
  push_machine
  canary_up
  sweep_dir="$state_dir/sweep"
  rm -rf "$sweep_dir"
  mkdir -p "$sweep_dir"
  declare -A sweep_door=()
  for sweep_lane in "${sweep_lanes[@]}"; do
    [ -n "$sweep_lane" ] || continue
    sweep_kind="$(node "$repo_root/.Workflow/agent-workflows/shared/canary-fire-plan.ts" "$sweep_lane" | jq -r .kind)"
    case "$sweep_kind" in
      issues_labeled | issues_closed) sweep_group="issues" ;;
      *) sweep_group="$sweep_lane" ;;
    esac
    sweep_door["$sweep_group"]="${sweep_door["$sweep_group"]:-} $sweep_lane"
  done
  log "pinning ${#sweep_lanes[@]} stubs in turn, because the contents API serialises on the branch head"
  for sweep_lane in "${sweep_lanes[@]}"; do
    [ -n "$sweep_lane" ] || continue
    "$0" prove --lane "$sweep_lane" --pin-only --no-push --no-wip >"$sweep_dir/$sweep_lane.pin.log" 2>&1 \
      || log "could not pin $sweep_lane (see $sweep_dir/$sweep_lane.pin.log)"
  done
  log "sweeping ${#sweep_lanes[@]} lanes on $CANARY_RUNNER in ${#sweep_door[@]} groups; lanes behind one door go in turn, groups go at once"
  for sweep_group in "${!sweep_door[@]}"; do
    (
      for sweep_lane in ${sweep_door["$sweep_group"]}; do
        lane_code=0
        "$0" prove --lane "$sweep_lane" --no-push --no-wip --timeout "$timeout_s" \
          >"$sweep_dir/$sweep_lane.log" 2>&1 || lane_code=$?
        echo "$lane_code" >"$sweep_dir/$sweep_lane.code"
      done
    ) &
  done
  wait
  printf '%s\n' "================================================================ canary: sweep of $id"
  sweep_failed=0
  for sweep_lane in "${sweep_lanes[@]}"; do
    [ -n "$sweep_lane" ] || continue
    sweep_code="$(cat "$sweep_dir/$sweep_lane.code" 2>/dev/null || echo 2)"
    case "$sweep_code" in
      0) sweep_verdict="green" ;;
      1) sweep_verdict="red"; sweep_failed=1 ;;
      *) sweep_verdict="unfired"; sweep_failed=1 ;;
    esac
    sweep_why="$(grep -a -m1 '^why  ' "$sweep_dir/$sweep_lane.log" 2>/dev/null | sed 's/^why  *//' || true)"
    [ -n "$sweep_why" ] || sweep_why="$(grep -a '^canary: ' "$sweep_dir/$sweep_lane.log" 2>/dev/null | tail -1 | sed 's/^canary: //' || true)"
    sweep_why="$(cut -c1-96 <<<"$sweep_why")"
    printf '%-24s %-8s %s\n' "$sweep_lane" "$sweep_verdict" "$sweep_why"
  done
  printf '%s\n' "logs          $sweep_dir/<lane>.log"
  exit "$sweep_failed"
fi

reds="$(cat "$cap_file" 2>/dev/null || echo 0)"
if [ "$reds" -ge "$CAP" ]; then
  die "$reds reds in a row on $id; the loop is not converging; stop, rethink, then bin/canary prove --reset-cap"
fi

log "id=$id  branch=$branch → $canary_branch  target=$canary_repo  lane=$lane"

stub_path=".github/workflows/$lane-caller.yml"
[ -f "$repo_root/$stub_path" ] || die "no $stub_path in the machine; lane '$lane' has no caller stub"
plan_json="$(node "$repo_root/.Workflow/agent-workflows/shared/canary-fire-plan.ts" "$lane")" \
  || die "could not derive a fire for lane '$lane'; see above"
fire_kind="$(jq -r .kind <<<"$plan_json")"
[ "$fire_kind" != "refuse" ] || die "$(jq -r .reason <<<"$plan_json")"
fire_event="$(jq -r '.event // empty' <<<"$plan_json")"
fire_event_type="$(jq -r '.eventType // empty' <<<"$plan_json")"
demand_label="$(jq -r '.demands.label // empty' <<<"$plan_json")"
demand_issue_labels="$(jq -r '.demands.issueLabels // [] | .[]' <<<"$plan_json")"
demand_state_reason="$(jq -r '.demands.stateReason // empty' <<<"$plan_json")"
demand_pr_title="$(jq -r '.demands.pullRequestTitle // empty' <<<"$plan_json")"
log "lane '$lane' wakes on $fire_kind${fire_event_type:+ ($fire_event_type)}"
[ "$(jq -r '.demands // empty' <<<"$plan_json")" = "" ] \
  || log "its job guard demands $(jq -c .demands <<<"$plan_json")"

fixture_json="$(npx --no-install tsx "$repo_root/.Workflow/agent-workflows/shared/canary-fixture.ts" "$lane")" \
  || die "could not read the fixture for lane '$lane'; see above"
if [ "$(jq -r '.kind // empty' <<<"$fixture_json")" = "none" ]; then
  fixture_json=""
else
  log "lane '$lane' needs a seeded issue; the fixture stands in for the lane upstream of it"
fi

head="$(git -C "$repo_root" rev-parse HEAD)"
expect_head="${CANARY_EXPECT_HEAD:-$head}"
if [ "$push" = "1" ]; then
  commit_wip
  head="$(git -C "$repo_root" rev-parse HEAD)"
  expect_head="${CANARY_EXPECT_HEAD:-$head}"
  push_machine
  canary_up
else
  target_branch="$(gh api "repos/$canary_repo" --jq .default_branch)"
fi

expected_stub="$(sed -E "s#(uses: $machine_repo/\.github/workflows/$lane\.yml)@main#\1@$canary_branch#" "$repo_root/$stub_path" \
  | awk -v runner="$CANARY_RUNNER" -v ref="$canary_branch" -v usline="uses: $machine_repo/.github/workflows/$lane.yml@$canary_branch" '
    BEGIN { pending = 0; inserted = 0 }
    {
      if (pending) {
        pending = 0
        if ($0 ~ /^[ \t]*with:[ \t]*$/) {
          print
          indent = $0
          sub(/with:.*/, "", indent)
          print indent "  runner: " runner
          print indent "  machine_ref: " ref
          inserted = 1
          next
        } else {
          indent = prevline
          sub(/uses:.*/, "", indent)
          print indent "with:"
          print indent "  runner: " runner
          print indent "  machine_ref: " ref
          inserted = 1
        }
      }
      print
      if (index($0, usline) > 0) { pending = 1; prevline = $0 }
    }
    END {
      if (pending && !inserted) {
        indent = prevline
        sub(/uses:.*/, "", indent)
        print indent "with:"
        print indent "  runner: " runner
        print indent "  machine_ref: " ref
      }
    }
  ')"
remote_stub_json="$(gh api "repos/$canary_repo/contents/$stub_path?ref=$target_branch" 2>/dev/null || echo '{}')"
remote_stub="$(jq -r '.content // ""' <<<"$remote_stub_json" | base64 -d 2>/dev/null || true)"
remote_stub_sha="$(jq -r '.sha // empty' <<<"$remote_stub_json")"

fire_sha=""
if [ "$remote_stub" != "$expected_stub" ]; then
  stub_result="$(put_file "$stub_path" "canary: pin $lane to $canary_branch on the $CANARY_RUNNER runner" "$expected_stub" "$remote_stub_sha")" \
    || die "could not pin $stub_path on $canary_repo; the contents API serialises on the branch head, so pin before firing, never beside another fire"
  read -r stub_commit stub_blob <<<"$stub_result"
  if [ "$fire_kind" = "push" ] && [ "$stub_blob" != "$remote_stub_sha" ]; then
    fire_sha="$stub_commit"
    log "stub written on $canary_repo ($fire_sha), and that commit is the fire"
  elif [ "$fire_kind" = "push" ]; then
    log "stub PUT changed nothing (blob $stub_blob unchanged), firing separately"
  else
    log "stub written on $canary_repo ($stub_commit): pin only; $lane wakes on $fire_kind, not push"
  fi
fi

if [ "$pin_only" = "1" ]; then
  log "pinned $stub_path"
  exit 0
fi

for run in $(gh api "repos/$canary_repo/actions/runs?per_page=50" \
  | jq -r --arg p "$stub_path" '.workflow_runs[] | select(.status=="in_progress" or .status=="queued" or .status=="waiting") | select(.path==$p) | .id'); do
  gh run cancel "$run" -R "$canary_repo" >/dev/null 2>&1 || true
  log "cancelled stale $lane run $run"
done

ensure_label() { # name, idempotent; issues:labeled needs a label to exist before it can be added
  gh label create "$1" -R "$canary_repo" --color eeeeee >/dev/null 2>&1 || true
}
demanded_label_args() { # → --label args for every label the job guard demands the issue carry
  local label
  while IFS= read -r label; do
    [ -n "$label" ] || continue
    ensure_label "$label"
    printf '%s\n%s\n' "--label" "$label"
  done <<<"$demand_issue_labels"
}
seed_issue() { # why → issue number, on stdout
  local url label_args
  mapfile -t label_args < <(demanded_label_args)
  url="$(gh issue create -R "$canary_repo" --title "canary: fire $lane ($1)" \
    "${label_args[@]}" \
    --body "Seed issue created by bin/canary to fire the '$lane' lane." 2>&1 | tail -1)"
  echo "${url##*/}"
}
seed_fixture_issue() { # → issue number, on stdout, carrying the comments the lane's collector reads
  local url num label comment label_args
  while IFS= read -r label; do ensure_label "$label"; done < <(jq -r '.ensureLabels[]' <<<"$fixture_json")
  mapfile -t label_args < <(demanded_label_args)
  url="$(gh issue create -R "$canary_repo" "${label_args[@]}" \
    --title "$(jq -r .title <<<"$fixture_json")" --body "$(jq -r .body <<<"$fixture_json")" 2>&1 | tail -1)"
  num="${url##*/}"
  while IFS= read -r comment; do
    gh issue comment "$num" -R "$canary_repo" --body "$(base64 -d <<<"$comment")" >/dev/null
  done < <(jq -r '.comments[] | @base64' <<<"$fixture_json")
  echo "$num"
}

fixture_issue=""
if [ -n "$fixture_json" ]; then
  fixture_issue="$(seed_fixture_issue)"
  log "seeded issue #$fixture_issue on $canary_repo with $(jq '.comments | length' <<<"$fixture_json") marker comment(s)"
fi

before_time="$(date -u +%FT%TZ)"
before_run="$(gh api "repos/$canary_repo/actions/runs?per_page=1" --jq '.workflow_runs[0].id // 0')"
case "$fire_kind" in
  push)
    if [ -z "$fire_sha" ]; then
      fire_path=".canary-fire-$lane"
      fire_json="$(gh api "repos/$canary_repo/contents/$fire_path?ref=$target_branch" 2>/dev/null || echo '{}')"
      read -r fire_sha _ <<<"$(put_file "$fire_path" "canary: fire $lane at $head" "$(date -u +%FT%TZ) machine=$head" "$(jq -r '.sha // empty' <<<"$fire_json")")"
    fi
    log "fired: $canary_repo@$fire_sha (push)"
    ;;
  workflow_dispatch)
    gh api -X POST "repos/$canary_repo/actions/workflows/$(basename "$stub_path")/dispatches" -f "ref=$target_branch" >/dev/null
    log "fired: $canary_repo workflow_dispatch on $stub_path@$target_branch"
    ;;
  repository_dispatch)
    dispatch_args=(-X POST "repos/$canary_repo/dispatches" -f "event_type=$fire_event_type" -f "client_payload[canary]=$id")
    [ -z "$fixture_issue" ] || dispatch_args+=(-f "client_payload[issue]=$fixture_issue")
    gh api "${dispatch_args[@]}" >/dev/null
    log "fired: $canary_repo repository_dispatch event_type=$fire_event_type${fixture_issue:+ issue=$fixture_issue}"
    ;;
  issues_labeled)
    if [ -n "$fixture_issue" ]; then
      issue_num="$fixture_issue"
      fire_label="$(jq -r .label <<<"$fixture_json")"
    else
      fire_label="${demand_label:-canary-fire}"
      ensure_label "$fire_label"
      issue_num="$(seed_issue "issues:labeled")"
    fi
    gh issue edit "$issue_num" -R "$canary_repo" --add-label "$fire_label" >/dev/null
    log "fired: $canary_repo issue #$issue_num labeled $fire_label"
    ;;
  issues_closed)
    issue_num="${fixture_issue:-$(seed_issue "issues:closed")}"
    close_args=(-R "$canary_repo")
    [ -z "$demand_state_reason" ] || close_args+=(--reason "$demand_state_reason")
    gh issue close "$issue_num" "${close_args[@]}" >/dev/null
    log "fired: $canary_repo issue #$issue_num closed${demand_state_reason:+ as $demand_state_reason}"
    ;;
  pull_request_closed)
    pr_branch="canary-fire-$(date -u +%s)"
    base_sha="$(gh api "repos/$canary_repo/git/ref/heads/$target_branch" --jq .object.sha)"
    gh api "repos/$canary_repo/git/refs" -f "ref=refs/heads/$pr_branch" -f "sha=$base_sha" >/dev/null
    fire_blob="$(gh api "repos/$canary_repo/contents/.canary-fire?ref=$pr_branch" --jq '.sha // empty' 2>/dev/null || true)"
    put_args=(-X PUT "repos/$canary_repo/contents/.canary-fire" -f "message=canary: fire $lane" \
      -f "content=$(printf '%s\n' "fired at $before_time" | base64 -w0)" -f "branch=$pr_branch")
    [ -z "$fire_blob" ] || put_args+=(-f "sha=$fire_blob")
    gh api "${put_args[@]}" >/dev/null
    pr_url="$(gh pr create -R "$canary_repo" --base "$target_branch" --head "$pr_branch" \
      --title "${demand_pr_title:-canary: fire $lane}" --body "Seed pull request created by bin/canary to fire the '$lane' lane." 2>&1 | tail -1)"
    gh pr close "$pr_url" -R "$canary_repo" >/dev/null
    log "fired: $canary_repo PR ${pr_url##*/} closed"
    ;;
  *)
    die "internal error: canary-fire-plan.ts returned an unhandled kind '$fire_kind'"
    ;;
esac

run_id=""
deadline=$((SECONDS + 120))
if [ "$fire_kind" = "push" ]; then
  while [ -z "$run_id" ]; do
    run_id="$(gh api "repos/$canary_repo/actions/runs?head_sha=$fire_sha" \
      | jq -r --arg p "$stub_path" '[.workflow_runs[] | select(.path == $p)] | .[0].id // empty')"
    [ -n "$run_id" ] && break
    [ $SECONDS -lt $deadline ] || die "the push fired nothing in 120 s; does $stub_path trigger on push to $target_branch, and did the change touch a path outside paths-ignore?"
    sleep 3
  done
else
  while [ -z "$run_id" ]; do
    run_id="$(gh api "repos/$canary_repo/actions/runs?event=$fire_event&per_page=30" \
      | jq -r --argjson b "$before_run" --arg p "$stub_path" \
        '[.workflow_runs[] | select(.id > $b) | select(.path == $p)] | sort_by(.id) | .[0].id // empty')"
    [ -n "$run_id" ] && break
    [ $SECONDS -lt $deadline ] || die "the $fire_kind fire triggered nothing $stub_path answered in 120 s; does that stub actually declare that trigger on $canary_repo's default branch?"
    sleep 3
  done
fi
log "run $run_id: https://github.com/$canary_repo/actions/runs/$run_id"
deadline=$((SECONDS + timeout_s))
status=""
while [ "$status" != "completed" ]; do
  status="$(gh api "repos/$canary_repo/actions/runs/$run_id" --jq .status)"
  [ "$status" = "completed" ] && break
  [ $SECONDS -lt $deadline ] || { gh run cancel "$run_id" -R "$canary_repo" >/dev/null 2>&1 || true; die "run $run_id still $status after ${timeout_s}s; cancelled"; }
  sleep 5
done
conclusion="$(gh api "repos/$canary_repo/actions/runs/$run_id" --jq .conclusion)"

jobs_json="$(gh api "repos/$canary_repo/actions/runs/$run_id/jobs")"
log_file="$state_dir/run-$run_id.log"
for _ in 1 2 3 4 5; do
  if gh run view "$run_id" -R "$canary_repo" --log >"$log_file" 2>/dev/null && [ -s "$log_file" ]; then break; fi
  sleep 3
done
plain="$(cut -f3- "$log_file" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //')"

sha_after_sync() {
  awk -v repo="$1" '
    $0 == "Syncing repository: " repo { armed = 1; next }
    armed && /^[0-9a-f]{40}$/ { print; exit }
  ' <<<"$plain"
}
machine_sha="$(sha_after_sync "$machine_repo" || true)"
target_sha="$(sha_after_sync "$canary_repo" || true)"
uses_line="$(grep -m1 -E "^Uses: $machine_repo/\.github/workflows/$lane\.yml@" <<<"$plain" || true)"

verdict="green"
reasons=()
[ "$conclusion" = "success" ] || { verdict="red"; reasons+=("run concluded '$conclusion'"); }
if [ -z "$machine_sha" ]; then
  verdict="red"; reasons+=("could not read the machine checkout's SHA from the log, so nothing proves which machine ran")
elif [ "$machine_sha" != "$expect_head" ]; then
  verdict="red"; reasons+=("FALSE GREEN: machine ran at ${machine_sha:0:12}, branch head is ${expect_head:0:12}")
fi
ran_jobs="$(jq -r '[.jobs[] | select(.conclusion != "skipped")] | length' <<<"$jobs_json")"
[ "$ran_jobs" -gt 0 ] || { verdict="red"; reasons+=("no job ran; every job was skipped"); }
off_runner="$(jq -r --arg l "$CANARY_RUNNER" '[.jobs[] | select(.conclusion != "skipped") | select((.labels // []) | index($l) | not) | .name] | join(", ")' <<<"$jobs_json")"
[ -z "$off_runner" ] || { verdict="red"; reasons+=("ran off the '$CANARY_RUNNER' runner: $off_runner"); }

failed_steps="$(jq -r '.jobs[] | . as $j | (.steps // [])[] | select(.conclusion=="failure") | "\($j.name) → \(.name)"' <<<"$jobs_json")"
fingerprint="$(printf '%s\n%s\n%s' "$verdict" "${reasons[*]:-}" "$failed_steps" | sha1sum | cut -c1-12)"
same_as_last=0
[ "$(cat "$fingerprint_file" 2>/dev/null || true)" = "$fingerprint" ] && same_as_last=1
printf '%s' "$fingerprint" >"$fingerprint_file"

if [ "$verdict" = "green" ]; then
  rm -f "$cap_file"
else
  echo $((reds + 1)) >"$cap_file"
fi

{
  echo "================================================================ canary: $verdict"
  echo "id            $id"
  echo "lane          $lane"
  echo "branch head   $head"
  echo "machine ran   ${machine_sha:-<unknown>}   $([ "$machine_sha" = "$expect_head" ] && echo '== head ✓' || echo '!= head ✗')"
  echo "target        $canary_repo@${target_sha:-<unknown>}"
  echo "workflow      ${uses_line#Uses: }"
  echo "run           https://github.com/$canary_repo/actions/runs/$run_id   $conclusion"
  jq -r '.jobs[] | "job           \(.name): \(.conclusion)  runner=\(.runner_name // "-") labels=\((.labels // []) | join(","))  \(.started_at // "")..\(.completed_at // "")"' <<<"$jobs_json"
  for r in "${reasons[@]:-}"; do [ -n "$r" ] && echo "why           $r"; done
  if [ -n "$failed_steps" ]; then
    echo "failed steps"
    sed 's/^/              /' <<<"$failed_steps"
    echo "--- last 40 lines of the failed step(s)"
    gh run view "$run_id" -R "$canary_repo" --log-failed 2>/dev/null | cut -f3- | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //' | grep -v '^\s*$' | tail -40
  fi
  if [ "$verdict" != "green" ]; then
    echo "reds in a row $((reds + 1)) of $CAP$([ "$same_as_last" = "1" ] && echo '   SAME SUMMARY AS LAST TIME: no progress')"
  fi
  echo "log           $log_file"
}

[ "$verdict" = "green" ] && exit 0 || exit 1
