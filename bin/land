#!/bin/bash
set -uo pipefail

head=$(git rev-parse HEAD) || exit 1
top=$(git rev-parse --show-toplevel)
log="$(git rev-parse --path-format=absolute --git-common-dir)/machine-logs/land-${head:0:7}-${top##*/}.log"
mkdir -p "${log%/*}"
find "${log%/*}" -maxdepth 1 -type f -name '*.log' -mmin +10080 -delete 2>/dev/null
rm -f "$log"
[[ $log == "$top/"* ]] && shown="${log#"$top/"}" || shown="$log"
err=$(mktemp)
trap 'rm -f "$err"' EXIT

call() {
  local label=$1
  shift
  if ! said=$("$@" 2>"$err"); then
    { printf -- '--- %s ---\n%s\n' "$*" "$said"; cat "$err"; } >>"$log"
    printf 'land: %s failed; log %s\n' "$label" "$shown" >&2
    exit 1
  fi
}

call "git fetch" git fetch --quiet origin main

if [[ -d $(git rev-parse --git-path rebase-merge) || -d $(git rev-parse --git-path rebase-apply) ]]; then
  printf 'land: a rebase is already in progress here, so nothing landed; finish it or abort it first\n' >&2
  exit 1
fi

if [[ -n $(git rev-list origin/main..HEAD) ]] && ! git merge-base --is-ancestor origin/main HEAD; then
  if ! git rebase --quiet --autostash origin/main >/dev/null 2>"$err"; then
    { printf -- '--- git rebase origin/main ---\n'; cat "$err"; } >>"$log"
    git rebase --abort >/dev/null 2>&1
    printf 'land: HEAD does not rebase cleanly onto origin/main, so nothing landed; run git rebase origin/main, resolve it, and land again\n' >&2
    exit 1
  fi
  head=$(git rev-parse HEAD)
fi

if [[ -z $(git rev-list origin/main..HEAD) ]]; then
  printf 'Nothing to land: HEAD is already on origin/main.\n'
  exit 0
fi

closing_keyword='\b(close|closes|closed|fix|fixes|fixed|resolve|resolves|resolved)\b:?[ \t]+#[0-9]+'

src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
for commit in $(git rev-list origin/main..HEAD); do
  git log -1 --format=%B "$commit" | node "$src/em-dash.ts"
  case $? in
    0) ;;
    1)
      printf 'land: commit %s carries an em dash in its message, so nothing landed; reword it\n' "$(git rev-parse --short=7 "$commit")" >&2
      exit 1
      ;;
    *)
      printf 'land: the em dash check could not read commit %s\n' "$(git rev-parse --short=7 "$commit")" >&2
      exit 1
      ;;
  esac

  matched=$(git log -1 --format=%B "$commit" | grep -ioE "$closing_keyword" | head -1)
  if [[ -n $matched ]]; then
    printf 'land: commit %s carries a closing keyword before #%s, so nothing landed; reword it\n' "$(git rev-parse --short=7 "$commit")" "${matched##*#}" >&2
    exit 1
  fi
done

branch="land/${head:0:12}"
call "git push" git push --quiet origin "HEAD:refs/heads/$branch"

call "gh pr create" gh pr create --base main --head "$branch" \
  --title "$(git log -1 --format=%s HEAD)" \
  --body "$(git log --reverse --format='- %s' origin/main..HEAD)"
url=$said
gh pr merge "$branch" --auto --merge --match-head-commit "$head" >/dev/null 2>&1 ||
  call "gh pr merge" gh pr merge "$branch" --merge --match-head-commit "$head"

verdict='if .state == "CLOSED" then "closed" elif .mergeStateStatus == "DIRTY" then "conflicts" else (first(.statusCheckRollup[]? | select((.conclusion // .state) | IN("FAILURE", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "ERROR")) | .name // .context) | "failed \(.)") end'

for (( waited = 0; ; waited += pause )); do
  call "git fetch" git fetch --quiet origin main
  git merge-base --is-ancestor "$head" origin/main && break
  read -r state check < <(gh pr view "$branch" --json state,mergeStateStatus,statusCheckRollup --jq "$verdict" 2>/dev/null)
  case ${state:-} in
    closed)
      printf 'land: %s was closed without merging\n' "$url" >&2
      exit 1
      ;;
    conflicts)
      gh pr close "$branch" --delete-branch >/dev/null 2>&1
      printf 'land: %s conflicts with main; closed it, so land again to rebase\n' "$url" >&2
      exit 1
      ;;
    failed)
      gh pr close "$branch" --delete-branch >/dev/null 2>&1
      printf 'land: %s failed on %s; closed it, so fix it and land again\n' "$check" "$url" >&2
      exit 1
      ;;
  esac
  if (( waited >= ${LAND_WAIT_SECONDS:-1800} )); then
    printf 'Merges when its checks pass: %s\n' "$url"
    exit 0
  fi
  pause=$(( waited < 60 ? 2 : 15 ))
  sleep "$pause"
done

if [[ $(git rev-parse HEAD) == "$head" ]] && git merge --quiet --ff-only origin/main >/dev/null 2>&1; then
  printf 'Landed %s\n' "$url"
else
  printf 'Landed %s, but this checkout could not fast-forward; run git pull.\n' "$url"
fi
