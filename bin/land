#!/bin/bash
set -uo pipefail

usage='land: usage: land [--ticket <number> [--approved <reason>]]; it lands HEAD on the default branch through a PR, from the ticket'"'"'s branch with --ticket, commenting the reviewer'"'"'s reason on that PR before it merges with --approved'
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  printf '%s\n' "$usage"
  exit 0
fi
ticket=
approved=
if [[ ($# -eq 2 || ($# -eq 4 && $3 == --approved && -n $4)) && $1 == --ticket && $2 =~ ^[0-9]+$ ]]; then
  ticket=$2
  approved=${4:-}
elif [[ $# -ne 0 ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

head=$(git rev-parse HEAD) || exit 1
top=$(git rev-parse --show-toplevel)
log="$(git rev-parse --path-format=absolute --git-common-dir)/machine-logs/land-${head:0:7}-${top##*/}.log"
mkdir -p "${log%/*}"
find "${log%/*}" -maxdepth 1 -type f -name '*.log' -mmin +10080 -delete 2>/dev/null
rm -f "$log"
[[ $log == "$top/"* ]] && shown="${log#"$top/"}" || shown="$log"
err=$(mktemp)
trap 'rm -f "$err"' EXIT

call() {
  local label=$1
  shift
  if ! said=$("$@" 2>"$err"); then
    { printf -- '--- %s ---\n%s\n' "$*" "$said"; cat "$err"; } >>"$log"
    printf 'land: %s failed; log %s\n' "$label" "$shown" >&2
    exit 1
  fi
}

default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD)
default_branch=${default_branch#origin/}
if [[ -z $default_branch ]]; then
  call "git ls-remote" git ls-remote --symref origin HEAD
  default_branch=$(awk '$1 == "ref:" && $3 == "HEAD" { sub("^refs/heads/", "", $2); print $2 }' <<<"$said")
  if [[ -z $default_branch ]]; then
    printf 'land: origin names no default branch, so nothing landed\n' >&2
    exit 1
  fi
fi

call "git fetch" git fetch --quiet origin "$default_branch"

if [[ -d $(git rev-parse --git-path rebase-merge) || -d $(git rev-parse --git-path rebase-apply) ]]; then
  printf 'land: a rebase is already in progress here, so nothing landed; finish it or abort it first\n' >&2
  exit 1
fi

dirty=$(git status --porcelain --untracked-files=all | cut -c4- | paste -sd, - | sed 's/,/, /g')
if [[ -n $dirty ]]; then
  printf 'land: the tree differs from the commit, so nothing landed; commit or remove %s and land again\n' "$dirty" >&2
  exit 1
fi

onto_default_branch() {
  if [[ -n $(git rev-list "origin/$default_branch..HEAD") ]] && ! git merge-base --is-ancestor "origin/$default_branch" HEAD; then
    if ! git rebase --quiet "origin/$default_branch" >/dev/null 2>"$err"; then
      { printf -- '--- git rebase origin/%s ---\n' "$default_branch"; cat "$err"; } >>"$log"
      git rebase --abort >/dev/null 2>&1 # quiet: the rebase's own error is already in the log
      printf 'land: HEAD does not rebase cleanly onto origin/%s, so nothing landed; run git rebase origin/%s, resolve it, and land again\n' "$default_branch" "$default_branch" >&2
      exit 1
    fi
    head=$(git rev-parse HEAD)
  fi
}

onto_default_branch

posted() {
  call "gh api statuses" gh api -X POST "repos/{owner}/{repo}/statuses/$head" -f state=success -f "context=$1" -f "description=$2"
}

if [[ -z $(git rev-list "origin/$default_branch..HEAD") ]]; then
  printf 'Nothing to land: HEAD is already on origin/%s.\n' "$default_branch"
  exit 0
fi

closing_keyword='\b(close|closes|closed|fix|fixes|fixed|resolve|resolves|resolved)\b:?[ \t]+#[0-9]+'

src="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../src" && pwd)"
for commit in $(git rev-list "origin/$default_branch..HEAD"); do
  git log -1 --format=%B "$commit" | node "$src/em-dash.ts"
  case $? in
    0) ;;
    1)
      printf 'land: commit %s carries an em dash in its message, so nothing landed; reword it\n' "$(git rev-parse --short=7 "$commit")" >&2
      exit 1
      ;;
    *)
      printf 'land: the em dash check could not read commit %s\n' "$(git rev-parse --short=7 "$commit")" >&2
      exit 1
      ;;
  esac

  matched=$(git log -1 --format=%B "$commit" | grep -ioE "$closing_keyword" | head -1)
  if [[ -n $matched ]]; then
    printf 'land: commit %s carries a closing keyword before #%s, so nothing landed; reword it\n' "$(git rev-parse --short=7 "$commit")" "${matched##*#}" >&2
    exit 1
  fi
done

if [[ -n $ticket ]]; then
  call "spelled" "$src/../bin/spelled" TICKET_PREFIX
  branch="$said$ticket"
  call "gh issue view" gh issue view "$ticket" --json title --jq .title
  title=$said
  body="Builds #$ticket"$'\n\n'
else
  branch="land/${head:0:12}"
  title=
  body=
fi
tree_pathed() {
  PATH="${TREE_PATH:+$TREE_PATH:}$PATH" "$@"
}

url=
judged="judged by land on the commit before the push (ADR-0008)"
for (( round = 1; ; round++ )); do
  changed=$(git diff --name-only "origin/$default_branch" HEAD)
  if [[ $changed == docs/buckets.md ]]; then
    judged="docs/buckets.md alone changed from $default_branch, and no check step reads it (#1382)"
  elif ! tree_pathed check --full --covered >"$err" 2>&1; then
    { printf -- '--- check --full --covered ---\n'; cat "$err"; } >>"$log"
    if ! tree_pathed check --full --publish >&2; then
      printf 'land: the full check went red on the commit, so nothing was pushed; fix what it names and land again\n' >&2
      exit 1
    fi
  fi
  call "git push" git push --quiet --force origin "HEAD:refs/heads/$branch"
  posted check "$judged"
  if [[ -z $url ]]; then
    call "gh pr list" gh pr list --head "$branch" --base "$default_branch" --state open --json url --jq '.[0].url // empty'
    url=$said
  fi
  if [[ -z $url ]]; then
    call "gh pr create" gh pr create --base "$default_branch" --head "$branch" \
      --title "${title:-$(git log -1 --format=%s HEAD)}" \
      --body "$body$(git log --reverse --format='- %s' "origin/$default_branch..HEAD")"
    url=$said
  fi
  if [[ -n $approved ]]; then
    call "gh pr comment" gh pr comment "$url" --body "The reviewer approved #$ticket: $approved"
    approved=
  fi
  if gh pr merge "$branch" --merge --match-head-commit "$head" >/dev/null 2>"$err"; then
    break
  fi
  { printf -- '--- gh pr merge %s ---\n' "$branch"; cat "$err"; } >>"$log"
  refusal=$(head -n 1 "$err")
  state=$(gh pr view "$branch" --json mergeStateStatus --jq .mergeStateStatus 2>>"$log") || state=unread
  case $state in
    BEHIND | UNKNOWN)
      if (( round >= ${LAND_ROUNDS:-3} )); then
        printf 'land: %s did not merge in %s rounds of rebase and push: %s; it is left open\n' "$url" "$round" "$refusal" >&2
        exit 1
      fi
      [[ $state == UNKNOWN ]] && sleep "${LAND_PAUSE_SECONDS:-2}"
      call "git fetch" git fetch --quiet origin "$default_branch"
      onto_default_branch
      ;;
    DIRTY)
      gh pr close "$branch" --delete-branch >/dev/null
      printf 'land: %s conflicts with %s; closed it, so land again to rebase\n' "$url" "$default_branch" >&2
      exit 1
      ;;
    *)
      printf 'land: GitHub refused to merge %s: %s; it is left open\n' "$url" "$refusal" >&2
      exit 1
      ;;
  esac
done

call "git fetch" git fetch --quiet origin "$default_branch"
if [[ $(git rev-parse HEAD) == "$head" ]] && git merge --quiet --ff-only "origin/$default_branch" >/dev/null 2>&1; then # quiet: the else branch says the checkout could not fast-forward
  printf 'Landed %s\n' "$url"
else
  printf 'Landed %s, but this checkout could not fast-forward; run git pull.\n' "$url"
fi

main_checkout=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
if [[ $main_checkout != "$top" ]] && ! git -C "$main_checkout" merge --quiet --ff-only "origin/$default_branch" >/dev/null 2>&1; then # quiet: the line below names the checkout left behind
  printf 'land: the main checkout %s could not fast-forward, so the tools launched from it are not the merged ones\n' "$main_checkout" >&2
fi
