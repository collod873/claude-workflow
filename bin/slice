#!/bin/bash
set -uo pipefail

usage="slice: usage: slice <spec number>"

if [[ ${1:-} == "--help" ]]; then
  printf '%s\n' "$usage"
  exit 0
fi

spec=${1:-}
if [[ $# -ne 1 || ! $spec =~ ^[0-9]+$ ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
exec node "$src/slicer.ts" "$spec"
