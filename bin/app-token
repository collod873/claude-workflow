#!/bin/bash
set -uo pipefail

refuse() {
  printf 'app-token: %s\n' "$1" >&2
  exit 1
}

for named in CORE_APP_CLIENT_ID CORE_APP_PRIVATE_KEY; do
  [[ -n ${!named:-} ]] || refuse "$named is not set, so nothing acts as the App; no run falls back to GITHUB_TOKEN"
done
[[ -n ${GITHUB_REPOSITORY:-} ]] || refuse "GITHUB_REPOSITORY is not set, so there is no installation to mint for"

urlsafe() { base64 -w0 | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | urlsafe)
claims=$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$CORE_APP_CLIENT_ID" | urlsafe)
signature=$(printf '%s.%s' "$header" "$claims" |
  openssl dgst -sha256 -sign <(printf '%s\n' "$CORE_APP_PRIVATE_KEY") -binary 2>/dev/null | urlsafe) ||
  refuse "the App key did not sign; it is set but openssl would not read it"
[[ -n $signature ]] || refuse "the App key did not sign; it is set but openssl would not read it"

asked() {
  local said
  said=$(curl --silent --show-error --max-time 20 --header "Authorization: Bearer $header.$claims.$signature" \
    --header "Accept: application/vnd.github+json" --header "X-GitHub-Api-Version: 2022-11-28" "$@" 2>/dev/null) || return 1
  printf '%s' "$said"
}

installation=$(asked "https://api.github.com/repos/$GITHUB_REPOSITORY/installation" | jq -er .id) ||
  refuse "GitHub named no installation of the App on $GITHUB_REPOSITORY"

token=$(asked --request POST "https://api.github.com/app/installations/$installation/access_tokens" | jq -er .token) ||
  refuse "GitHub minted no installation token for the App"

printf '::add-mask::%s\n' "$token"
printf 'GH_TOKEN=%s\n' "$token" >>"${GITHUB_ENV:-/dev/stdout}"
