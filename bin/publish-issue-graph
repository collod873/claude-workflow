#!/bin/bash
set -euo pipefail
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
repo_root="$(cd "$(dirname "$self")/.." && pwd)"
exec npx tsx "$repo_root/.Workflow/agent-workflows/to-tickets/publish-issue-graph.cli.ts" "$@"
