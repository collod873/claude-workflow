#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target_root="${TARGET_WORKSPACE:-$repo_root}"
adr_dir="$target_root/docs/adr"

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-60 | sed -E 's/-+$//'
}

usage() {
  echo "usage: bin/new-adr \"the ruling as a sentence\"" >&2
  echo "       bin/new-adr --amends NNNN \"the ruling as a sentence\"" >&2
  echo "       bin/new-adr --land docs/adr/draft-<slug>.md" >&2
  echo "  e.g. bin/new-adr \"Event-driven triggers only, never a clock\"" >&2
}

highest_on_disk() {
  find "$adr_dir" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.md' -printf '%f\n' 2>/dev/null \
    | cut -c1-4 | sort -n | tail -1
}

highest_on_origin() {
  git -C "$target_root" rev-parse --git-dir >/dev/null 2>&1 || return 0
  git -C "$target_root" fetch --quiet origin main 2>/dev/null || true
  git -C "$target_root" ls-tree --name-only FETCH_HEAD -- docs/adr/ 2>/dev/null \
    | sed -E 's#.*/##' | grep -E '^[0-9]{4}-.*\.md$' 2>/dev/null \
    | cut -c1-4 | sort -n | tail -1 || true
}

land() {
  local draft="$1"
  [ -n "$draft" ] || { usage; exit 1; }
  [ -e "$draft" ] || { echo "no such draft: $draft" >&2; exit 1; }

  local base
  base="$(basename "$draft")"
  case "$base" in
    draft-*.md) ;;
    *) echo "not a draft (expected draft-<slug>.md): $draft" >&2; exit 1 ;;
  esac

  local disk origin next
  disk="$(highest_on_disk)"
  origin="$(highest_on_origin)"
  next=$((10#${disk:-0}))
  [ $((10#${origin:-0})) -gt "$next" ] && next=$((10#${origin:-0}))
  next=$(printf '%04d' $((next + 1)))

  local slug landed
  slug="${base#draft-}"
  slug="${slug%.md}"
  landed="$adr_dir/$next-$slug.md"
  [ -e "$landed" ] && { echo "already exists: $landed" >&2; exit 1; }

  if git -C "$target_root" ls-files --error-unmatch "$draft" >/dev/null 2>&1; then
    git -C "$target_root" mv "$draft" "$landed"
  else
    mv "$draft" "$landed"
  fi

  local adr_check="${HOME:-}/bin/adr-check"
  if [ ! -f "$adr_dir/INDEX.md" ]; then
    : # No index in the target to keep current — an enrolled repository that never adopted one.
  elif [ ! -x "$adr_check" ]; then
    echo "new-adr: no adr-check on this machine — docs/adr/INDEX.md not regenerated, and bin/gauntlet push will refuse this" >&2
  else
    ( cd "$target_root" && "$adr_check" --fix >/dev/null ) || true
  fi

  echo "$landed"
}

if [ "${1:-}" = "--land" ]; then
  land "${2:-}"
  exit 0
fi

amends=""
if [ "${1:-}" = "--amends" ]; then
  if [ $# -lt 3 ]; then
    usage
    exit 1
  fi
  amends="$2"
  shift 2
fi

if [ $# -eq 0 ]; then
  usage
  exit 1
fi

title="$*"
mkdir -p "$adr_dir"

file="$adr_dir/draft-$(slugify "$title").md"
[ -e "$file" ] && { echo "already exists: $file" >&2; exit 1; }

if [ -n "$amends" ]; then
  amends_num=$(printf '%04d' "$((10#$amends))")
  cat > "$file" <<EOF
---
status: constraint
date: $(date +%Y-%m-%d)
amends: ADR-$amends_num
reversal:
---

# $title

EOF
else
  cat > "$file" <<EOF
---
status: constraint
date: $(date +%Y-%m-%d)
reversal:
---

# $title

EOF
fi

echo "$file"

if [ -t 1 ] && [ -n "${EDITOR:-}" ]; then exec "$EDITOR" "$file"; fi
