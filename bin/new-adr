#!/usr/bin/env bash
# Create the next ADR from a title. Numbering is derived, never typed.
set -euo pipefail

amends=""
if [ "${1:-}" = "--amends" ]; then
  if [ $# -lt 3 ]; then
    echo "usage: bin/new-adr --amends NNNN \"the ruling as a sentence\"" >&2
    exit 1
  fi
  amends="$2"
  shift 2
fi

if [ $# -eq 0 ]; then
  echo "usage: bin/new-adr \"the ruling as a sentence\"" >&2
  echo "  e.g. bin/new-adr \"Event-driven triggers only, never a clock\"" >&2
  exit 1
fi

title="$*"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
adr_dir="$repo_root/docs/adr"
mkdir -p "$adr_dir"

# Highest existing number wins, so a gap never causes a collision.
next=$(find "$adr_dir" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.md' -printf '%f\n' 2>/dev/null \
  | cut -c1-4 | sort -n | tail -1)
next=$(printf '%04d' $((10#${next:-0} + 1)))

slug=$(printf '%s' "$title" \
  | tr '[:upper:]' '[:lower:]' \
  | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
  | cut -c1-60 | sed -E 's/-+$//')

file="$adr_dir/$next-$slug.md"
[ -e "$file" ] && { echo "already exists: $file" >&2; exit 1; }

if [ -n "$amends" ]; then
  amends_num=$(printf '%04d' "$((10#$amends))")
  cat > "$file" <<EOF
# $title

Recorded $(date +%Y-%m-%d).

Amends: ADR-$amends_num

EOF
else
  cat > "$file" <<EOF
# $title

Recorded $(date +%Y-%m-%d).

EOF
fi

echo "$file"

# The editor is for a human at a keyboard, so the condition is whether there is one — not whether
# `EDITOR` happens to be set. A hosted runner sets `EDITOR=vi` in its default environment, so the
# older `-n "$EDITOR"` form `exec`ed vi against no terminal and blocked until the job's timeout
# killed it, which is how the accept lane spent ten minutes filing its first ADR and then died
# cancelled rather than failed. #122 hit the same line from the test suite and was answered by
# stripping `EDITOR`/`VISUAL` in that caller; a guard every caller has to remember is the obligation
# this repo refuses to build, so the check lives here where one condition covers all of them.
if [ -t 1 ] && [ -n "${EDITOR:-}" ]; then exec "$EDITOR" "$file"; fi
