#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import adr_shape

GIT_TIMEOUT_SECONDS = 5

TEMPLATE = (
    '---\n'
    'status: constraint\n'
    'date: {date}\n'
    'reversal:{amends}\n'
    '---\n'
    '\n'
    '# {title}\n'
    '\n'
)

BODY_PROMPT = """<!-- Why this binds: what forces it. {cap} words max. Evidence, measurements
     and worked examples go to docs/research/ and are linked.

     **Rejected: <the alternative>.** <What it would have cost.> -->
"""

NO_REJECTED = (
    "the body names no rejected alternative. Add a line starting `**Rejected: <the "
    "alternative>.**` saying what else was on the table and what it would have cost."
)

_FORMAT_DOC_CANDIDATES = (
    Path(__file__).resolve().parent.parent / "domain-modeling" / "ADR-FORMAT.md",
    Path(__file__).resolve().parent.parent / ".claude" / "skills" / "domain-modeling" / "ADR-FORMAT.md",
)
FORMAT_DOC = next((c for c in _FORMAT_DOC_CANDIDATES if c.is_file()), _FORMAT_DOC_CANDIDATES[0])
BAR_HEADING = "## The bar"
BAR_FRAME = "The bar, from {doc}:\n\n{bar}"
BAR_POINTER = (
    "The bar is stated in the `domain-modeling` skill's ADR-FORMAT.md, which is not "
    "readable from here ({doc}). Read it before writing the body."
)


def bar() -> str:
    try:
        text = FORMAT_DOC.read_text(encoding="utf-8")
    except OSError:
        return BAR_POINTER.format(doc=FORMAT_DOC)

    section: list[str] = []
    taking = False
    for line in text.splitlines():
        if line.startswith("## "):
            if taking:
                break
            taking = line.strip() == BAR_HEADING
            continue
        if taking:
            section.append(line)

    rendered = "\n".join(section).strip()
    if not rendered:
        return BAR_POINTER.format(doc=FORMAT_DOC)
    return BAR_FRAME.format(doc=FORMAT_DOC, bar=rendered)


def target_root_for(machine_root: Path) -> Path:
    override = os.environ.get("TARGET_WORKSPACE", "").strip()
    return Path(override).resolve() if override else machine_root


def origin_numbers(target_root: Path) -> list[int]:
    found: list[int] = []
    try:
        subprocess.run(
            ["git", "-C", str(target_root), "fetch", "--quiet", "origin"],
            capture_output=True, timeout=GIT_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.SubprocessError):
        pass
    for ref in ("origin/main", "origin/master", "HEAD"):
        try:
            out = subprocess.run(
                ["git", "-C", str(target_root), "ls-tree", "-r", "--name-only", ref],
                capture_output=True, text=True, timeout=GIT_TIMEOUT_SECONDS,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        if out.returncode != 0:
            continue
        for line in out.stdout.splitlines():
            p = Path(line.strip())
            if p.parent.name != "adr" or p.parent.parent.name != "docs":
                continue
            m = adr_shape.LANDED_RE.match(p.name)
            if m:
                found.append(int(m.group(1)))
    return found


def corpus_dir_for(target_root: Path, corpus_arg: str | None) -> Path:
    base = target_root if corpus_arg is None else target_root / corpus_arg
    return adr_shape.adr_dir(base)


def write_index(corpus_dir: Path) -> Path:
    corpus = adr_shape.load_corpus_dir(corpus_dir)
    path = corpus_dir / adr_shape.INDEX_NAME
    path.write_text(adr_shape.render_index(corpus), encoding="utf-8")
    return path


def run_index_renderer(machine_root: Path, target_root: Path, corpus_dir: Path) -> Path:
    renderer = machine_root / ".Workflow" / "agent-workflows" / "shared" / "adr-index.cli.ts"
    tsx = machine_root / "node_modules" / ".bin" / "tsx"
    if corpus_dir != adr_shape.adr_dir(target_root) or not renderer.is_file() \
            or not os.access(tsx, os.X_OK):
        return write_index(corpus_dir)
    subprocess.run(
        [str(tsx), str(renderer), "--fix", str(target_root)],
        cwd=machine_root, capture_output=True,
    )
    return corpus_dir / adr_shape.INDEX_NAME


def draft(machine_root: Path, target_root: Path, title: str, amends: int | None,
          corpus_arg: str | None) -> int:
    d = corpus_dir_for(target_root, corpus_arg)
    d.mkdir(parents=True, exist_ok=True)
    path = d / f"{adr_shape.DRAFT_PREFIX}{adr_shape.slugify(title)}.md"
    if path.exists():
        print(f"error: already exists: {path}", file=sys.stderr)
        return 1
    amends_line = f"\namends: ADR-{amends:04d}" if amends is not None else ""
    path.write_text(
        TEMPLATE.format(date=date.today().isoformat(), title=title, amends=amends_line)
        + BODY_PROMPT.format(cap=adr_shape.WORD_CAP),
        encoding="utf-8",
    )
    print(path)
    print(bar(), file=sys.stderr)
    if sys.stdout.isatty():
        editor = os.environ.get("EDITOR")
        if editor:
            os.execvp(editor, [editor, str(path)])
    return 0


def land(machine_root: Path, target_root: Path, draft_path: Path) -> int:
    if not draft_path.exists():
        print(f"error: no such draft: {draft_path}", file=sys.stderr)
        return 1
    m = adr_shape.DRAFT_RE.match(draft_path.name)
    if not m:
        print(
            f"error: not a draft (expected {adr_shape.DRAFT_PREFIX}<slug>.md): {draft_path}",
            file=sys.stderr,
        )
        return 1

    text = draft_path.read_text(encoding="utf-8", errors="replace")
    try:
        warnings = adr_shape.validate(text)
    except adr_shape.ValidationError as e:
        print(f"error: {draft_path.name}: {e}", file=sys.stderr)
        return 1
    for w in warnings:
        print(f"warning: {w}", file=sys.stderr)

    if not adr_shape.rejected_alternative(text):
        print(f"error: {draft_path.name}: {NO_REJECTED}", file=sys.stderr)
        return 1

    number = adr_shape.next_number(target_root, origin_numbers(target_root))
    corpus_dir = draft_path.parent
    landed = corpus_dir / f"{number:04d}-{m.group(1)}.md"
    if landed.exists():
        print(f"error: already exists: {landed}", file=sys.stderr)
        return 1

    tracked = subprocess.run(
        ["git", "-C", str(target_root), "ls-files", "--error-unmatch", str(draft_path)],
        capture_output=True, text=True,
    ).returncode == 0
    if tracked:
        subprocess.run(
            ["git", "-C", str(target_root), "mv", str(draft_path), str(landed)],
            capture_output=True,
        )
    if draft_path.exists():
        draft_path.rename(landed)

    index = run_index_renderer(machine_root, target_root, corpus_dir)
    print(landed)
    print(f"index: {index}", file=sys.stderr)
    return 0


class _StderrHelpParser(argparse.ArgumentParser):
    def print_help(self, file=None) -> None:
        super().print_help(sys.stderr if file is None else file)


def main(argv: list[str] | None = None) -> int:
    p = _StderrHelpParser(
        prog="new-adr",
        description="File an ADR as a draft; claim its number when it lands.",
    )
    p.add_argument("--land", metavar="DRAFT", help="land a draft: validate, number, index")
    p.add_argument("--amends", type=int, metavar="NNNN",
                   help="this ruling replaces ADR-NNNN (rare; correct in place instead "
                        "unless the constraint itself reverses)")
    p.add_argument("--corpus", metavar="DIR",
                   help="draft under DIR/docs/adr instead of the root corpus; --land "
                        "ignores this and uses the draft's own directory")
    p.add_argument("title", nargs="*", help="the ruling, stated as a sentence")
    args = p.parse_args(argv)

    root = adr_shape.repo_root_from()
    if root is None:
        print("error: not inside a git repository", file=sys.stderr)
        return 1
    target_root = target_root_for(root)

    if args.land:
        if args.title:
            p.error("--land takes no title")
        if args.corpus:
            p.error("--land takes no --corpus; the draft's own directory names it")
        return land(root, target_root, Path(args.land).resolve())

    if not args.title:
        p.error("give the ruling as a sentence, e.g. "
                'new-adr "Triage labels are positions, not verdicts"')
    return draft(root, target_root, " ".join(args.title), args.amends, args.corpus)


if __name__ == "__main__":
    sys.exit(main())
