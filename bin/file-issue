#!/bin/bash
set -uo pipefail

usage="file-issue: usage: file-issue ticket|note --title <title> --body-file <path>"
shown_refusals=4
most_shown=5

kind=${1:-}
shift 2>/dev/null
title=""
body=""
while (( $# > 0 )); do
  case $1 in
    --title) title=${2:-}; shift 2 || break ;;
    --body-file) body=${2:-}; shift 2 || break ;;
    *) break ;;
  esac
done

if [[ ($kind != ticket && $kind != note) || -z $title || -z $body || ! -f $body || $# -gt 0 ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

src="$(cd "${BASH_SOURCE[0]%/*}/../src" && pwd)"
top=$(git rev-parse --show-toplevel) || exit 1
log="$(git rev-parse --path-format=absolute --git-common-dir)/machine-logs/file-issue-$$.log"
mkdir -p "${log%/*}"
[[ $log == "$top/"* ]] && shown="${log#"$top/"}" || shown="$log"

out=$(mktemp)
err=$(mktemp)
trap 'rm -f "$out" "$err"' EXIT

status=0
if [[ $kind == ticket ]]; then
  node "$src/check-runner.ts" <"$body" >"$out" 2>"$err"
  status=$?
fi

if (( status == 0 )); then
  node "$src/post.ts" "$kind" "$title" <"$body" >"$out" 2>"$err"
  status=$?
fi

if (( status == 0 )); then
  cat "$out"
  exit 0
fi

count=$(grep -c '' "$err")
{ printf '%s refusals\n' "$count"; cat "$err"; } >"$log"
if (( count > most_shown )); then
  head -"$shown_refusals" "$err" >&2
  printf 'file-issue: %s refusals, %s shown; nothing filed; log %s\n' "$count" "$shown_refusals" "$shown" >&2
else
  cat "$err" >&2
fi
exit 1
