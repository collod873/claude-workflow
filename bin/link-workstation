#!/usr/bin/env python3
import argparse
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BIN_DIR = REPO_ROOT / "bin"

ACTIONS: list[str] = []


def note(action: str) -> None:
    ACTIONS.append(action)
    print(action)


def linkable_bin_tools() -> list[str]:
    if not BIN_DIR.is_dir():
        return []
    return sorted(
        p.name for p in BIN_DIR.iterdir()
        if p.is_file() and p.suffix != ".py" and os.access(p, os.X_OK)
    )


def ensure_symlink(link: Path, target: Path, apply: bool) -> None:
    if link.is_symlink():
        if link.resolve() == target.resolve():
            return
        note(f"replace {link} -> {target} (was {os.readlink(link)})")
        if apply:
            link.unlink()
            link.symlink_to(target)
        return
    if link.exists():
        note(f"skip {link}: exists and is not a symlink")
        return
    note(f"link {link} -> {target}")
    if apply:
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(target)


def link_bin(apply: bool) -> None:
    dest_dir = Path.home() / "bin"
    for name in linkable_bin_tools():
        ensure_symlink(dest_dir / name, BIN_DIR / name, apply)


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="link-workstation")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    link_bin(bool(args.apply))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
