#!/usr/bin/env python3
import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BIN_DIR = REPO_ROOT / "bin"
SKILLS_DIR = REPO_ROOT / ".claude" / "skills"
HOOKS_DIR = REPO_ROOT / ".claude" / "hooks"
ROSTER_PATH = HOOKS_DIR / "roster.json"

TOOL_SCOPED_EVENTS = {"PreToolUse", "PostToolUse", "PostToolUseFailure", "PermissionRequest"}

ACTIONS: list[str] = []


def note(action: str) -> None:
    ACTIONS.append(action)
    print(action)


def linkable_bin_tools() -> list[str]:
    if not BIN_DIR.is_dir():
        return []
    return sorted(
        p.name for p in BIN_DIR.iterdir()
        if p.is_file() and p.suffix != ".py" and os.access(p, os.X_OK)
    )


def skill_dirs() -> list[str]:
    if not SKILLS_DIR.is_dir():
        return []
    return sorted(p.name for p in SKILLS_DIR.iterdir() if p.is_dir())


def hook_names() -> list[str]:
    if not HOOKS_DIR.is_dir():
        return []
    return sorted(p.name for p in HOOKS_DIR.iterdir() if p.is_file())


def ensure_symlink(link: Path, target: Path, apply: bool) -> None:
    if link.is_symlink():
        if link.resolve() == target.resolve():
            return
        note(f"replace {link} -> {target} (was {os.readlink(link)})")
        if apply:
            link.unlink()
            link.symlink_to(target)
        return
    if link.exists():
        note(f"skip {link}: exists and is not a symlink")
        return
    note(f"link {link} -> {target}")
    if apply:
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(target)


def link_bin(apply: bool) -> None:
    dest_dir = Path.home() / "bin"
    for name in linkable_bin_tools():
        ensure_symlink(dest_dir / name, BIN_DIR / name, apply)


def link_skills(apply: bool) -> None:
    dest_dir = Path.home() / ".claude" / "skills"
    for name in skill_dirs():
        ensure_symlink(dest_dir / name, SKILLS_DIR / name, apply)


def prune_superseded_hook_symlinks(apply: bool) -> None:
    dest_dir = Path.home() / ".claude" / "hooks"
    agent_skills_hooks = (Path.home() / ".agents" / "skills" / "hooks").resolve()
    if not dest_dir.is_dir():
        return
    for name in hook_names():
        link = dest_dir / name
        if not link.is_symlink():
            continue
        try:
            resolved = link.resolve()
            resolved.relative_to(agent_skills_hooks)
        except (OSError, ValueError):
            continue
        note(f"remove {link} (pointed at {os.readlink(link)}, superseded by the dispatcher)")
        if apply:
            link.unlink()


def dispatcher_entry(event: str) -> dict:
    entry: dict = {"hooks": [
        {"type": "command", "command": f"python3 {HOOKS_DIR / 'dispatch.py'} {event}"}
    ]}
    if event in TOOL_SCOPED_EVENTS:
        entry = {"matcher": "*", **entry}
    return entry


def rewrite_settings(apply: bool) -> int:
    settings_path = Path.home() / ".claude" / "settings.json"
    roster = json.loads(ROSTER_PATH.read_text())

    try:
        raw = settings_path.read_text()
    except OSError as exc:
        print(f"link-workstation: cannot read {settings_path} ({exc})", file=sys.stderr)
        return 2
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(f"link-workstation: {settings_path} is not valid JSON ({exc})", file=sys.stderr)
        return 2
    if not isinstance(data, dict):
        print(f"link-workstation: {settings_path} must be a JSON object", file=sys.stderr)
        return 2

    old_hooks = data.get("hooks")
    notification = old_hooks.get("Notification") if isinstance(old_hooks, dict) else None

    new_hooks = {event: [dispatcher_entry(event)] for event in sorted(roster)}
    if notification is not None:
        new_hooks["Notification"] = notification

    new_data = dict(data)
    new_data["hooks"] = new_hooks

    note(f"rewrite {settings_path}'s hooks key to one dispatcher entry per roster event")
    if not apply:
        return 0

    backup_path = settings_path.with_name("settings.json.pre-dispatch")
    if not backup_path.exists():
        backup_path.write_text(raw)

    fd, tmp_name = tempfile.mkstemp(dir=str(settings_path.parent), prefix=".settings.json.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(new_data, indent=2) + "\n")
        os.replace(tmp_name, settings_path)
    except Exception:
        os.unlink(tmp_name)
        raise
    return 0


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="link-workstation")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    parser.add_argument("--settings", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    apply = bool(args.apply)

    link_bin(apply)
    link_skills(apply)
    prune_superseded_hook_symlinks(apply)

    if args.settings:
        return rewrite_settings(apply)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
