#!/bin/bash
# The gauntlet. One check runner, called by every venue that can afford it.
#
# Absolute interpreter, not `/usr/bin/env bash`: git hooks and Claude Code hooks both run this in a
# shell nobody logged into, and `env` resolves `bash` through the PATH those shells may not have.
#
#   bin/gauntlet turn <file>   PostToolUse   budget <1s    typecheck + lint that file
#   bin/gauntlet stop          Stop          budget <10s   typecheck + lint + unit suite
#   bin/gauntlet push          pre-push      budget <60s   typecheck + lint + unit suite
#
# A check sits at the earliest venue whose budget it fits (ADR-0010), because what
# earliest buys is the cost of the *repair*, not the cost of the check: a type error caught in the
# turn that caused it is fixed with the context still hot, and the same error caught in Actions
# costs a cold run reconstructing what the author already knew.
#
# Today every check fits every venue here — the suite is ~1.7s and typecheck ~0.7s — so `stop` and
# `push` run the same set. They stay separate names because the venues are different: `push` is the
# one an agent has to route around deliberately, and it is the one that fails closed.
#
# What runs is whatever `.claude/contract.json` names (ADR-0056), not a hardcoded `tsc`/`eslint`/
# `vitest` — this repo isn't special-cased over any other repo the contract might describe. The
# contract is read once per run, through one `node` invocation that resolves every slot this venue
# needs, because a lookup that cost one process per check is the thing #117 asked this rewrite to
# stop doing.
#
# Exit codes are three, not two, and the third is the point:
#   0  clean
#   1  a check failed        — a real finding
#   2  the checks could not run — a broken gauntlet, never reported as a finding
#
# Two roots (ADR-0139), not one. `repo_root` is the MACHINE — this checkout, where every check's
# own code lives, `.Workflow/agent-workflows/shared/*.ts` included. `target_root` is what gets
# checked: this repo's own tree by default, or an enrolled repository's checkout under
# `TARGET_WORKSPACE` when a caller sets it (every reusable lane runs with the machine at the
# workspace root and the target at `$TARGET_WORKSPACE`). Everything "about the repository being
# checked" — the contract, `docs/adr`, `.github/workflows`, every baseline file — reads and writes
# under `target_root`; everything "how to check it" runs as machine code, `node
# "$repo_root/.Workflow/..."`, given `target_root` as its argument.

set -uo pipefail

# Builtins only — `dirname` is a PATH lookup, and PATH is the thing we do not have yet.
here="${BASH_SOURCE[0]%/*}"
[ "$here" = "${BASH_SOURCE[0]}" ] && here="."
repo_root="$(cd "$here/.." && pwd)"
target_root="${TARGET_WORKSPACE:-$repo_root}"
# shellcheck source=bin/node-on-path.sh
. "$repo_root/bin/node-on-path.sh"

venue="${1:-}"
target="${2:-}"

case "$venue" in
  turn | stop | push) ;;
  *)
    echo "usage: bin/gauntlet <turn|stop|push> [file]" >&2
    exit 2
    ;;
esac

# The budget each venue is held to, in milliseconds, per the header above. Nothing enforces them — an
# over-budget venue reports itself and keeps running, because a gauntlet that refuses to run when
# it gets slow is a gauntlet that stops catching things exactly when the codebase got big enough
# to need it. The report is the signal to move a check down a venue.
case "$venue" in
  turn) budget_ms=1000 ;;
  stop) budget_ms=10000 ;;
  push) budget_ms=60000 ;;
esac

if ! node_on_path; then
  echo "gauntlet: no node on PATH — checks not run" >&2
  exit 2
fi

if [ "$venue" = "turn" ] && [ -n "$target" ] && [ ! -f "$target" ]; then
  # A target that is not there is a usage problem, not a finding. Running the resolved lint
  # command anyway would report a moved or deleted file as a code defect.
  echo "gauntlet: $target does not exist — checks not run" >&2
  exit 2
fi

# `GAUNTLET_CONTRACT` overrides which contract this run reads — the seam a test uses to exercise a
# contract shape (a dead command, a slot that forces the broader-slot degradation) without editing
# this repo's own `.claude/contract.json`. Nothing in production sets it.
contract_path="${GAUNTLET_CONTRACT:-$target_root/.claude/contract.json}"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# The one Node invocation this run makes. It imports the check-contract module — the shared reader
# #119 landed — reads and validates the contract, and resolves every slot this venue needs in a
# single process, then prints the results as `NAME_FIELD=value` shell assignments for the `eval`
# below to load. `turn` has no `lint_one` slot to ask for; requesting it is what makes the module
# degrade to the broader `lint` slot and report the substitution (ADR-0056).
read_slots() {
  local venue="$1" contract_path="$2" repo_root="$3"
  node --input-type=module - "$venue" "$contract_path" "$repo_root" <<'NODE_EOF'
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { pathToFileURL } from "node:url";

const [, , venue, contractPath, repoRoot] = process.argv;

const moduleUrl = pathToFileURL(
  join(repoRoot, ".Workflow/agent-workflows/shared/check-contract.ts"),
).href;
const { CheckContract, resolveSlot } = await import(moduleUrl);

let raw;
try {
  raw = readFileSync(contractPath, "utf8");
} catch (err) {
  console.error(`gauntlet: cannot read ${contractPath}: ${err.message}`);
  process.exit(1);
}

let contract;
try {
  contract = CheckContract.parse(JSON.parse(raw));
} catch (err) {
  console.error(`gauntlet: ${contractPath} is not a valid check contract: ${err.message}`);
  process.exit(1);
}

const requests =
  venue === "turn"
    ? [
        ["TYPECHECK", "typecheck"],
        ["LINT", "lint_one"],
      ]
    : [
        ["TYPECHECK", "typecheck"],
        ["LINT", "lint"],
        ["TEST", "test"],
      ];

function shQuote(value) {
  return `'${String(value).replace(/'/g, "'\\''")}'`;
}

const lines = [];
for (const [name, requested] of requests) {
  let resolution;
  try {
    resolution = resolveSlot(contract, requested);
  } catch (err) {
    console.error(`gauntlet: ${err.message}`);
    process.exit(1);
  }
  lines.push(`${name}_CMD=${resolution.cmd === null ? "''" : shQuote(resolution.cmd)}`);
  lines.push(`${name}_SLOT=${shQuote(resolution.slot)}`);
  lines.push(`${name}_SUBSTITUTED=${resolution.substituted ? 1 : 0}`);
  lines.push(`${name}_REQUESTED=${shQuote(resolution.requested ?? requested)}`);
}

process.stdout.write(lines.join("\n") + "\n");
NODE_EOF
}

if ! resolved="$(read_slots "$venue" "$contract_path" "$repo_root")" 2>"$tmp/resolve.err"; then
  echo "gauntlet: could not resolve $contract_path — checks not run" >&2
  cat "$tmp/resolve.err" >&2
  exit 2
fi
eval "$resolved"

checks="typecheck lint"
[ "$venue" != "turn" ] && checks="typecheck lint test"

# A slot resolved to a broader form than what this venue asked for is a real cost — the turn venue
# now lints the whole repo, not just the file that changed — and it is reported rather than run
# silently, the same way an over-budget venue reports itself below.
#
# `resolved_checks` is only the slots read above — `contract`, added to `checks` below, has no
# `_CMD`/`_SUBSTITUTED` shell variable to read, because it never goes through `resolveSlot`.
resolved_checks="$checks"
for name in $resolved_checks; do
  var_name="$(echo "$name" | tr '[:lower:]' '[:upper:]')"
  substituted_var="${var_name}_SUBSTITUTED"
  if [ "${!substituted_var}" = "1" ]; then
    requested_var="${var_name}_REQUESTED"
    slot_var="${var_name}_SLOT"
    echo "gauntlet: no ${!requested_var} slot in $contract_path — running the broader ${!slot_var} slot instead" >&2
  fi
  cmd_var="${var_name}_CMD"
  if [ -z "${!cmd_var}" ]; then
    slot_var="${var_name}_SLOT"
    echo "gauntlet: the ${!slot_var} slot in $contract_path names no command — checks not run" >&2
    exit 2
  fi
done

# `regenerate && diff` (ADR-0056) — push only. It is the standing check that replaces `CLAUDE.md`'s
# retired same-commit rule: a fresh probe of this tree is compared byte-for-byte against
# `$contract_path`, so a repo that grew a check since its contract was last generated goes red here
# instead of the contract quietly lying about itself. It reads `$contract_path`, the same file
# `GAUNTLET_CONTRACT` can redirect above, so a test exercises it without touching this repo's own
# `.claude/contract.json`.
#
# `corpus` is the same pattern reused for `adr-corpus.evidence.json` (spec #134, ticket #140): a
# fresh generation from `docs/adr/` and `docs/research/` compared byte-for-byte against the
# committed fixture, so a corpus that grew or shrank since the fixture was last generated goes red
# here instead of `missing-trailer.test.ts` quietly running against a stale snapshot.
#
# `wiring` is the third of the same family, and the one #183 asked for: knip, pointed at the lanes
# rather than at the test suite, answering whether anything this repo can actually *run* reaches a
# given file or export. It gates on the delta against a committed baseline, not on the whole
# answer, because it landed against 31 standing findings that are product decisions rather than
# lint fixes. New code wired to nothing fails the push that introduced it.
#
# `workflows` is actionlint, and it is here rather than only in `verify.yml` because a broken
# workflow file is the one defect CI structurally cannot report (ADR-0105). `workflow-lint.ts`'s
# docstring is the home for why, and for why needing Docker is not the ritual objection it looks
# like: the check costs nothing on a push that leaves `.github/workflows/` alone.
#
# `boundaries` is #305's prevent-side of module boundaries: `.dependency-cruiser.cjs` answers "may
# this import that?", `boundaries-baseline.ts` is the same baseline-the-delta shape `wiring` uses
# for knip, and `generate-boundaries-doc.ts`'s `diff` mode is the same `regenerate && diff` shape
# `contract`/`corpus` use — folded into this one check because all three read the same rules and a
# reader chasing a red `boundaries` has one place to look, not three.
[ "$venue" = "push" ] && checks="$checks contract corpus clones wiring workflows trailers adrs boundaries"

# Checks run concurrently, so a venue's wall clock is its slowest check rather than the sum of
# them. That is what keeps the whole set inside the in-turn budget.
run_check() {
  local name="$1"
  shift
  "$@" >"$tmp/$name.out" 2>&1
  echo "$?" >"$tmp/$name.exit"
}

# A contract slot runs at `target_root` with this gauntlet's own configuration unset. Whatever
# `TARGET_WORKSPACE` and `GAUNTLET_CONTRACT` mean to *this* run, they mean nothing to the target's
# `npm test` — and they are actively dangerous there: two of this repo's own tests spawn a scratch
# tree's `bin/gauntlet push` with the environment they inherited, and a `TARGET_WORKSPACE` leaked
# through that spawn pointed the scratch gauntlet at the real target, whose whole suite ran those
# two tests again, and so on until the runner killed the job (exit 143 after eight minutes, on the
# first push Verify after ADR-0139). A slot's environment is the target's, never the gauntlet's.
slot_env=(env -u TARGET_WORKSPACE -u GAUNTLET_CONTRACT)

started_ms=$(($(date +%s%N) / 1000000))
pids=()

run_check typecheck "${slot_env[@]}" bash -c "cd \"$target_root\" && $TYPECHECK_CMD" &
pids+=($!)

run_check lint "${slot_env[@]}" bash -c "cd \"$target_root\" && $LINT_CMD" &
pids+=($!)

if [ "$venue" = "push" ]; then
  # Every check below is machine code — `node "$repo_root/.Workflow/..."` — run against
  # `$target_root` as the tree it describes (ADR-0139). A target owes only its own
  # `.claude/contract.json`, so `contract` always runs; the rest of the six read a file the target
  # may or may not carry, and a missing one is a check that did not run, never a finding — the
  # same shape `clones` already had before this repo grew a second root.
  #
  # Argv, not a `bash -c` string: `$repo_root`/`$target_root`/`$contract_path` are passed straight
  # through as separate arguments, never interpolated into a shell command line, so a checkout
  # with a space in its path (this estate has one) cannot break this the way a hand-built string
  # could.
  run_check contract node \
    "$repo_root/.Workflow/agent-workflows/shared/generate-contract.ts" \
    diff "$target_root" "$contract_path" &
  pids+=($!)

  # Gated on the target's own fixture existing — a target with no `.Workflow/` (an enrolled
  # repository) has no ADR corpus fixture to diff and this check did not run.
  corpus_fixture="$target_root/.Workflow/agent-workflows/watchdog/adr-corpus.evidence.json"
  if [ -f "$corpus_fixture" ]; then
    run_check corpus node \
      "$repo_root/.Workflow/agent-workflows/shared/generate-corpus-fixture.ts" \
      diff "$target_root" "$corpus_fixture" &
    pids+=($!)
  fi

  # `clones` is the clone-gate baseline in the same `regenerate && diff` family, here so that what
  # lane 05 regenerates before its push (`regenerate-artifacts.ts`) is judged by the same venue
  # that judges its other two artifacts — `implement.test.ts` holds the two lists to each other.
  # `bin/clone-gate` in `npm run check` still runs after this on a push; the scan is the same and
  # both are concurrent with typecheck, so the wall clock does not move.
  #
  # Gated on the baseline file existing, because this script is portable (Lumaria runs it) and a
  # repo that never seeded a baseline has no clone gate turned on — the missing `clones.exit` below
  # reads as "did not run", never as a finding.
  clone_baseline="$target_root/.Workflow/agent-workflows/shared/clone-gate.baseline.json"
  if [ -f "$clone_baseline" ]; then
    run_check clones node \
      "$repo_root/.Workflow/agent-workflows/shared/prune-clone-baseline.ts" \
      diff "$target_root" "$clone_baseline" &
    pids+=($!)
  fi

  # Gated on the target's own wiring baseline — `wiring-baseline.ts`'s own `isConfigured` would
  # answer the same question with an internal exit 0, but that reads as "ran and found nothing",
  # not "did not run"; the file check here keeps the two distinct at the one venue whose report
  # actually says which happened.
  wiring_baseline="$target_root/.Workflow/agent-workflows/shared/wiring-baseline.json"
  if [ -f "$wiring_baseline" ]; then
    run_check wiring node \
      "$repo_root/.Workflow/agent-workflows/shared/wiring-baseline.ts" check "$target_root" &
    pids+=($!)
  fi

  # Always: a broken workflow file is the one defect CI structurally cannot report (ADR-0105), and
  # every enrolled repository carries at least its caller stubs. `pinRoot` (second argument) is
  # always the machine — `verify.yml`'s own `uses:` line is the one source of the actionlint pin,
  # and an enrolled target may carry no `verify.yml` of its own to read it from.
  run_check workflows node \
    "$repo_root/.Workflow/agent-workflows/shared/workflow-lint.ts" "$target_root" "$repo_root" &
  pids+=($!)

  # Gated on both halves of the target's own boundaries setup existing — the config that answers
  # "may this import that?" and the committed baseline the delta is judged against.
  boundaries_config="$target_root/.dependency-cruiser.cjs"
  boundaries_baseline="$target_root/.Workflow/agent-workflows/shared/boundaries-baseline.json"
  if [ -f "$boundaries_config" ] && [ -f "$boundaries_baseline" ]; then
    run_check boundaries bash -c \
      'node "$1/.Workflow/agent-workflows/shared/boundaries-baseline.ts" check "$2" \
        && node "$1/.Workflow/agent-workflows/shared/generate-boundaries-doc.ts" diff "$2" "$2/docs/agents/module-boundaries.md"' \
      _ "$repo_root" "$target_root" &
    pids+=($!)
  fi

  # An `Amends` trailer that names an ADR without the colon is invisible to both readers of the
  # amendment graph, so the successor reads as amended to a human and unamended to every machine.
  # Three shipped that way and their predecessors sat unstamped from August. The missing-trailer
  # counter flagged one and nothing happened, which is the difference this venue makes: a
  # malformed field is exact, so it refuses here rather than filing an issue nobody clears.
  #
  # No file-existence gate here: `trailer-form.ts` already treats a missing `docs/adr` as clean
  # (ENOENT → exit 0) rather than a finding, so a target with no ADR corpus reads the same way
  # whether the gate lives here or inside the script — kept inside, in the one place, per ADR-0139.
  run_check trailers node \
    "$repo_root/.Workflow/agent-workflows/shared/trailer-form.ts" "$target_root" &
  pids+=($!)

  # The ADR corpus's own shape, index freshness and citation integrity, through the machine-global
  # `~/bin/adr-check` rather than a copy vendored here — which is ADR-0097's rule, and the reason
  # that tool was written to find its repo from the working directory rather than from its own
  # location. Absent (a CI runner has no `~/bin`) it stands down at exit 0 rather than reporting
  # exit 2: "could not run" is not free here, because it makes the whole gauntlet exit 2 and
  # `.github/workflows/verify.yml` turns that into a red job — a machine-global tool this venue was
  # never going to have is plumbing, not a finding, and this venue refuses only on findings. A
  # machine that has the tool still gets the full check, against the target's own `docs/adr`.
  run_check adrs bash -c \
    'cd "$1" || exit 2; [ -d docs/adr ] || exit 0; [ -x "$HOME/bin/adr-check" ] || exit 0; exec "$HOME/bin/adr-check" >/dev/null' \
    _ "$target_root" &
  pids+=($!)
fi

sandbox=""
if [ "$venue" != "turn" ]; then
  # The suite runs against a decoy repository, named by the same three variables that let #86
  # happen: `GIT_DIR` beats a `cwd` and an argv `-C`, so a fixture that shells out to `git` writes
  # wherever they point. Twice in one hour they pointed here, and 74 fixture commits walked `main`
  # onto a chain of `seed` / `the release commit`; the second time it reached `origin`.
  #
  # `vitest.config.ts` scrubs them from every worker, and `git-env-sandbox.test.ts` asserts the
  # scrub is wired. Neither can speak for a test nobody has written yet, which is the half that
  # actually failed last time — the seam was already fixed, and the fixtures still wrote. So the
  # gate stops trusting the assertion and reads the decoy afterwards: an empty repository is the
  # whole suite demonstrating, at every venue that runs it, that it wrote to no repository but its
  # own fixtures. A future test author does not have to know this exists for it to hold.
  #
  # That assertion is `target_root`'s own — this repo's `vitest.config.ts` wires
  # `scrub-git-env.setup.ts` into every worker, but ADR-0139's target owes only its
  # `.claude/contract.json`, `docs/adr/` and `CODING_STANDARDS.md`, and a target that never took on
  # the scrub has every fixture that shells out to `git init && git commit` inherit this decoy
  # instead of dodging it — not a target defect the sandbox exists to catch, but the sandbox itself
  # breaking a suite that never opted in. So the decoy is gated on the same precondition-file shape
  # `corpus`/`clones`/`wiring`/`boundaries` already use: armed only where `target_root` carries the
  # scrub, unset entirely otherwise, with one line on stderr saying why.
  scrub_setup="$target_root/.Workflow/agent-workflows/shared/scrub-git-env.setup.ts"
  if [ -f "$scrub_setup" ]; then
    sandbox="$tmp/git-sandbox"
    if ! (
      unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_NAMESPACE
      git -c init.defaultBranch=main init -q "$sandbox"
    ) 2>"$tmp/sandbox-init.out"; then
      echo "gauntlet: could not create the git sandbox — checks not run" >&2
      cat "$tmp/sandbox-init.out" >&2
      exit 2
    fi

    # `GAUNTLET_VENUE` names the venue to whatever the test slot runs. The one reader today is the
    # clone gate: the `test` slot runs it (docs/agents/clone-gate.md rule 6 puts it there), and this
    # venue's `stop` form runs the `test` slot at every turn-end — so without a way to tell the two
    # apart, wiring the gate in would have put a two-second scan on every turn. The gauntlet does not
    # schedule the clone gate at any venue; `npm run check` and CI each run it once, deliberately.
    run_check test "${slot_env[@]}" \
      GAUNTLET_VENUE="$venue" \
      GIT_DIR="$sandbox/.git" \
      GIT_WORK_TREE="$sandbox" \
      GIT_INDEX_FILE="$sandbox/.git/index" \
      bash -c "cd \"$target_root\" && $TEST_CMD" &
    pids+=($!)
  else
    echo "gauntlet: $target_root carries no scrub-git-env.setup.ts — the git sandbox did not run; a fixture there that shells out to git runs with whatever GIT_DIR the caller's environment already carries" >&2
    run_check test "${slot_env[@]}" -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
      GAUNTLET_VENUE="$venue" \
      bash -c "cd \"$target_root\" && $TEST_CMD" &
    pids+=($!)
  fi
fi

for pid in "${pids[@]}"; do wait "$pid"; done
elapsed_ms=$((($(date +%s%N) / 1000000) - started_ms))

failed=0
failed_names=""
could_not_run=0

# Read the decoy. This is a finding about the suite, not about the code under test, so it is
# reported separately from `test` — a green suite that wrote into the sandbox is a worse result
# than a red one, and naming it `test` would bury that. Only when the sandbox actually ran: a
# target with no scrub never had one armed above, and there is nothing here to read.
if [ -n "$sandbox" ]; then
  sandbox_refs="$(
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_NAMESPACE
    git --git-dir="$sandbox/.git" for-each-ref
  )"
  sandbox_objects="$(
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_NAMESPACE
    git --git-dir="$sandbox/.git" count-objects | cut -d' ' -f1
  )"
  if [ -n "$sandbox_refs" ] || [ "$sandbox_objects" != "0" ]; then
    failed=1
    echo "--- git-sandbox ---"
    echo "A test wrote into the repository named by GIT_DIR — with that variable set in a real"
    echo "session, this is a write to your checkout (#86). $sandbox_objects loose object(s):"
    echo "$sandbox_refs"
  fi
fi

# A command a slot names that no longer runs — renamed, uninstalled, a typo in the contract — is
# the shell's own "command not found", exit 127. That is kept distinct from a check that ran and
# found something: the former is a broken gauntlet (exit 2), the latter is a real finding (exit 1).
#
# The checks below that this repo writes itself speak the same three codes back, so their own exit 2
# means "could not run" too — `workflow-lint` reporting that no Docker daemon answered is the case
# in hand. That reading is per-check and never global, because `tsc --noEmit` exits **2** for type
# errors: a finding, and the most common one there is. Reading a 2 the same way everywhere would
# turn every type error in this repo into "the gauntlet is broken", which is the one report
# ADR-0063 tells the bypass counter to ignore.
own_protocol=" contract corpus clones wiring workflows trailers adrs boundaries "
for name in $checks; do
  [ -f "$tmp/$name.exit" ] || continue
  code="$(cat "$tmp/$name.exit")"
  [ "$code" = "0" ] && continue
  speaks_protocol=0
  case "$own_protocol" in *" $name "*) speaks_protocol=1 ;; esac
  if [ "$code" = "127" ] || { [ "$code" = "2" ] && [ "$speaks_protocol" = "1" ]; }; then
    could_not_run=1
    echo "gauntlet: $name could not run" >&2
    cat "$tmp/$name.out" >&2
    continue
  fi
  failed=1
  failed_names="$failed_names $name"
  echo "--- $name ---"
  cat "$tmp/$name.out"
done

if [ "$elapsed_ms" -gt "$budget_ms" ]; then
  echo "gauntlet: $venue took ${elapsed_ms}ms against a ${budget_ms}ms budget" >&2
fi

# The verdict goes last, and on stdout, because that is the half a reader actually gets. A hook
# refusing a push makes git say only `error: failed to push some refs`, and `shared/reason.ts`
# recovers the diagnosis by keeping the **tail** of this output — which, until this line existed,
# was a vitest summary table naming no check. Now the tail opens with the answer, in every place
# that report is read: a lane's log, an issue comment, a walked-home ticket.
if [ "$failed" = "1" ]; then
  echo "gauntlet: FAILED at$failed_names"
fi

if [ "$could_not_run" = "1" ]; then
  exit 2
fi

exit "$failed"
