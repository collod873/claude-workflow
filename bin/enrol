#!/bin/bash
set -uo pipefail

repo=${1:-}
mode=${2:-}
if [[ $# -lt 1 || $# -gt 2 || ! $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ || ( -n $mode && $mode != --caller ) ]]; then
  printf 'enrol: usage: enrol <owner/repo> [--caller]\n' >&2
  printf 'enrol: with no step from Collin: gh workflow run enrol.yml -R %s/claude-workflow -f repo=<owner/repo>; that run holds every secret enrol sets, then gh run watch it\n' "$("$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/spelled" OWNER)" >&2
  exit 2
fi

src="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../src" && pwd)"
exec node "$src/enrol.ts" "$repo" $mode
