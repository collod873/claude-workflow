#!/bin/bash
set -uo pipefail

usage="probe: usage: probe [--in <owner/repo>] <script|claude> <command or prompt>"
given=("$@")
if [[ ${1:-} == --in ]]; then
  [[ ${2:-} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { printf '%s\n' "$usage" >&2; exit 2; }
  shift 2
fi

if [[ $# -ne 2 || ! $1 =~ ^(script|claude)$ || -z $2 ]]; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

src="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../src" && pwd)"
exec node "$src/probe.ts" "${given[@]}"
