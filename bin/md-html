  color-scheme: light dark;
  --paper: #faf9f5;
  --surface: #ffffff;
  --sunk: #f0eee8;
  --ink: #1a1917;
  --muted: #5f5c55;
  --faint: #8a867d;
  --rule: #ddd9d0;
  --rule-soft: #eae7e0;
  --accent: #1a6b7a;
  --mark: #a3234f;
  --mono: ui-monospace, "SF Mono", "IBM Plex Mono", Menlo, Consolas, monospace;
  --body: "Source Serif 4", Georgia, "Times New Roman", serif;
  --display: "Archivo", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root {
    --paper: #14161a;
    --surface: #1a1d22;
    --sunk: #21252b;
    --ink: #e4e6ea;
