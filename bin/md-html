#!/usr/bin/env node
/**
 * md-html: render a Markdown file to one standalone, styled HTML file.
 *
 * Usage: md-html <input.md> [-o out.html] [--title T] [--toc] [--stdout] [--open]
 *
 * The output is self-contained: CSS inlined, no scripts, no CDN, no network. It opens
 * from a file:// path, survives being emailed as an attachment, and can be handed to the
 * Artifact tool as-is when a hosted link is wanted.
 *
 * Markdown is GitHub-flavored (marked): tables, task lists, strikethrough, fenced code.
 * Headings get slug ids so deep links work. Tables and code blocks scroll inside their own
 * box rather than widening the page. Light and dark both come from `prefers-color-scheme`.
 *
 * marked is vendored under `lib/md-html/` next to this tree rather than installed globally,
 * so the tool keeps working when a global npm prefix is wiped.
 */

import { createRequire } from "node:module";
import { readFileSync, writeFileSync } from "node:fs";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";

const HERE = dirname(fileURLToPath(import.meta.url));
const require = createRequire(join(HERE, "../lib/md-html/package.json"));
const { Marked } = require("marked");

const USAGE = `md-html: render a Markdown file to one standalone, styled HTML file.

usage: md-html <input.md> [options]

options:
  -o, --out <file>   write here (default: input path with .html)
      --title <text> page title (default: the first H1, else the filename)
      --toc          prepend a table of contents built from H2 and H3
      --stdout       write the HTML to stdout instead of a file
      --open         open the written file in the Windows default browser
  -h, --help         this text

The output has no scripts and no network references, so it opens from a file:// path
and can be handed to the Artifact tool unchanged when a hosted link is wanted.`;

function die(msg) {
  process.stderr.write(`md-html: ${msg}\n`);
  process.exit(1);
}

function parseArgs(argv) {
  const opts = { input: undefined, out: undefined, title: undefined, toc: false, stdout: false, open: false };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    switch (arg) {
      case "-h":
      case "--help":
        process.stdout.write(`${USAGE}\n`);
        process.exit(0);
        break;
      case "-o":
      case "--out":
        opts.out = argv[++i];
        break;
      case "--title":
        opts.title = argv[++i];
        break;
      case "--toc":
        opts.toc = true;
        break;
      case "--stdout":
        opts.stdout = true;
        break;
      case "--open":
        opts.open = true;
        break;
      default:
        if (arg.startsWith("-")) die(`unknown option ${arg}`);
        if (opts.input !== undefined) die("more than one input file given");
        opts.input = arg;
    }
  }
  if (opts.input === undefined) die(`no input file given\n\n${USAGE}`);
  if (opts.out !== undefined && opts.stdout) die("--out and --stdout ask for two different destinations");
  return opts;
}

function escapeHtml(text) {
  return text
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

function slugger() {
  const seen = new Map();
  return (text) => {
    const base =
      text
        .toLowerCase()
        .replace(/<[^>]*>/g, "")
        .replace(/[^\w\- ]+/g, "")
        .trim()
        .replace(/\s+/g, "-") || "section";
    const n = seen.get(base) ?? 0;
    seen.set(base, n + 1);
    return n === 0 ? base : `${base}-${n}`;
  };
}

function renderMarkdown(source) {
  const headings = [];
  const slug = slugger();

  const instance = new Marked({ gfm: true, breaks: false });
  instance.use({
    renderer: {
      heading({ tokens, depth }) {
        const text = this.parser.parseInline(tokens);
        const id = slug(text);
        if (depth === 2 || depth === 3) headings.push({ depth, id, text });
        return `<h${depth} id="${id}">${text}</h${depth}>\n`;
      },
    },
  });

  const html = instance.parse(source).replaceAll("<table>", '<div class="tbl"><table>').replaceAll("</table>", "</table></div>");
  return { html, headings };
}

function firstHeading(source) {
  const match = /^#\s+(.+?)\s*$/m.exec(source);
  return match ? match[1] : undefined;
}

function tocHtml(headings) {
  if (headings.length === 0) return "";
  const items = headings
    .map(({ depth, id, text }) => `<li class="d${depth}"><a href="#${id}">${text}</a></li>`)
    .join("\n");
  return `<nav class="toc"><p class="toc-label">Contents</p>\n<ul>\n${items}\n</ul>\n</nav>\n`;
}

function withToc(html, toc) {
  if (toc === "") return html;
  const lead = /<\/h1>\n?(?:<p>.*?<\/p>\n?)*/s.exec(html);
  if (!lead) return toc + html;
  const at = lead.index + lead[0].length;
  return html.slice(0, at) + toc + html.slice(at);
}

const CSS = `
