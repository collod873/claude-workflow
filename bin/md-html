function page(title, bodyHtml) {
  return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${escapeHtml(title)}</title>
<style>${CSS}</style>
</head>
<body>
<main>
${bodyHtml}</main>
</body>
</html>
`;
}

function windowsPath(path) {
  const converted = spawnSync("wslpath", ["-w", path], { encoding: "utf8" });
  if (converted.error !== undefined || converted.status !== 0) return undefined;
  return converted.stdout.trim() || undefined;
}

function reg(key, value) {
  const query = spawnSync("reg.exe", ["query", key, ...value], { encoding: "utf8" });
  if (query.error !== undefined || query.status !== 0) return undefined;
  const match = /REG_SZ\s+(.+)/.exec(query.stdout.replaceAll("\r", ""));
  return match ? match[1].trim() : undefined;
}

function defaultBrowser() {
  const progId = reg(
    "HKCU\\Software\\Microsoft\\Windows\\Shell\\Associations\\UrlAssociations\\http\\UserChoice",
    ["/v", "ProgId"],
  );
  if (progId === undefined) return undefined;

  const command = reg(`HKCR\\${progId}\\shell\\open\\command`, ["/ve"]);
  const exe = command === undefined ? undefined : /^"([^"]+)"/.exec(command)?.[1];
  if (exe === undefined) return undefined;

  const linux = spawnSync("wslpath", ["-u", exe], { encoding: "utf8" });
  if (linux.error !== undefined || linux.status !== 0) return undefined;
  return linux.stdout.trim() || undefined;
}

/**
 * `explorer.exe` and `cmd.exe /c start` both fail silently on this machine, reporting success
 * while opening nothing, so neither can be a fallback anything falls back *from*. The registry
 * names the browser the user actually chose, and Chrome reads a `\\\\wsl.localhost\\...` path
 * directly, so nothing has to be copied onto the Windows side first.
 */
function openInBrowser(path) {
  if (spawnSync("wslview", [path], { stdio: "ignore" }).status === 0) return;

  const win = windowsPath(path);
  if (win === undefined) die(`wrote the page but wslpath could not convert ${path} for Windows`);

  const browser = defaultBrowser();
  if (browser === undefined) {
    die(`wrote the page but could not find the default browser; open it yourself at ${win}`);
  }

  const opened = spawnSync(browser, [win], { stdio: "ignore", timeout: 5000 });
  if (opened.error !== undefined && opened.error.code !== "ETIMEDOUT") {
    die(`wrote the page but ${browser} would not start it: ${opened.error.message}`);
  }
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const inputPath = resolve(opts.input);

  let source;
  try {
    source = readFileSync(inputPath, "utf8");
  } catch (err) {
    die(`could not read ${opts.input}: ${err.message}`);
  }

  const { html, headings } = renderMarkdown(source);
  const title = opts.title ?? firstHeading(source) ?? basename(inputPath).replace(/\.mdx?$/i, "");
  const document = page(title, opts.toc ? withToc(html, tocHtml(headings)) : html);

  if (opts.stdout) {
    process.stdout.write(document);
    return;
  }

  const outPath = resolve(opts.out ?? inputPath.replace(/\.mdx?$/i, "") + ".html");
  if (outPath === inputPath) die("refusing to overwrite the input file; pass -o");
  try {
    writeFileSync(outPath, document, "utf8");
  } catch (err) {
    die(`could not write ${outPath}: ${err.message}`);
  }
  process.stdout.write(`${outPath}\n`);
  if (opts.open) openInBrowser(outPath);
}

main();
